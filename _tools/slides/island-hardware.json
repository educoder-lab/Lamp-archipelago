    "22": {
      "slides": [
        {
          "layout": "title", "emoji": "🧠", "title": "CPU の仕組み",
          "subtitle": "コンピュータの頭脳は、\nどんな順番で仕事する？",
          "blocks": []
        },
        {
          "emoji": "👨‍🍳", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "👨‍🍳",
              "real": "レシピを **1 行ずつ**読んで\n料理をするシェフ。",
              "tech": "コンピュータの頭脳も同じ。\n命令を 1 つずつこなす。" }
          ]
        },
        {
          "emoji": "🧠", "title": "それが「CPU」",
          "blocks": [
            { "t": "big", "text": "**CPU** = 演算と制御", "sub": "中央処理装置。計算し、ほかへ指示する" }
          ]
        },
        {
          "emoji": "📝", "title": "レジスタは手元メモ",
          "blocks": [
            { "t": "analogy", "icon": "📝",
              "real": "まな板の横の小皿。\n今すぐ使う材料を置く。",
              "tech": "**レジスタ** = CPU 内の\n==超高速・ごく小さい== 記憶" }
          ]
        },
        {
          "emoji": "📍", "title": "次はここ、のしおり",
          "blocks": [
            { "t": "big", "text": "**プログラムカウンタ**", "sub": "次に実行する命令のアドレスを持つ" }
          ]
        },
        {
          "emoji": "👀", "title": "メモリ上の命令を見る",
          "blocks": [
            { "t": "array", "cells": ["命令A", "命令B", "命令C", "命令D"], "start": 100,
              "highlight": [2], "pointers": { "2": "PC" },
              "caption": "PC が指す番地が ==次に実行==" }
          ]
        },
        {
          "emoji": "🔄", "title": "命令サイクルの流れ",
          "blocks": [
            { "t": "flow", "steps": [
              { "icon": "📥", "label": "取出し", "sub": "命令を読む" },
              { "icon": "🔍", "label": "解読", "sub": "意味を解く" },
              { "icon": "⚙️", "label": "実行", "sub": "計算・転送" },
              { "icon": "✍️", "label": "書戻し", "sub": "結果を保存" }
            ], "caption": "このくり返しが **命令サイクル**" }
          ]
        },
        {
          "emoji": "⏱️", "title": "クロック周波数とは",
          "blocks": [
            { "t": "big", "text": "**クロック** = 手拍子の速さ", "sub": "1 秒の拍数。単位は GHz" }
          ]
        },
        {
          "emoji": "📐", "title": "1 拍の長さ",
          "blocks": [
            { "t": "table", "head": ["周波数", "1 拍"],
              "rows": [["1 GHz", "1 ナノ秒"], ["2 GHz", "0.5 ナノ秒"], ["3 GHz", "約 0.33 ナノ秒"]],
              "caption": "1 拍 = ==1 ÷ 周波数==" }
          ]
        },
        {
          "emoji": "⚠️", "title": "CPU がやらないこと",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "CPU は **演算と制御**。\n長期の保存はメモリやディスクの仕事。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "命令サイクルで「意味を読み解く」段階は？",
              "choices": ["取出し", "解読", "実行", "書戻し"],
              "answer": 1, "explain": "意味を調べるのが **解読**。",
              "hint": "取出しの次。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "CPU の仕事として適切でないのは？",
              "choices": ["演算", "制御", "比較判断", "長期の倉庫保管"],
              "answer": 3, "explain": "長期保存はメモリ／ディスクの仕事。",
              "hint": "頭脳は計算と指示。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**CPU** … 演算と制御", "**PC** … 次の命令の番地", "**命令サイクル** … 取出し→解読→実行→書戻し"] }
          ]
        }
      ]
    },
