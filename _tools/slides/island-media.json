{
  "domain": "island-media",
  "lessons": {
    "62": {
      "slides": [
        {
          "layout": "title", "emoji": "🖼️", "title": "画像と音声のデータ",
          "subtitle": "写真や音は、\nどうやって 0 と 1 になる？",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🎨",
              "real": "モザイクの絵は、\n**小さなタイル**を並べる。",
              "tech": "写真も同じ。\n色の点（ピクセル）を並べる。" }
          ]
        },
        {
          "emoji": "🧩", "title": "それが「ラスタ画像」",
          "blocks": [
            { "t": "big", "text": "**ラスタ画像** = 点の集まり", "sub": "BMP / JPEG / PNG。拡大するとギザギザ" }
          ]
        },
        {
          "emoji": "🧮", "title": "ドット数の例",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "640×480 の写真",
              "rows": [
                { "label": "横", "value": "640 ピクセル" },
                { "label": "縦", "value": "480 ピクセル" },
                { "label": "合計", "value": "640×480 = ==307,200== 点", "hl": true }
              ],
              "why": "画素が多いほど細かいが、データも大きくなる。" }
          ]
        },
        {
          "emoji": "📐", "title": "設計図タイプもある",
          "blocks": [
            { "t": "analogy", "icon": "📐",
              "real": "「ここに円」と**手順だけ**書く。\n大きくしてもきれいに描き直せる。",
              "tech": "**ベクタ画像**。数式で図形を定義。" }
          ]
        },
        {
          "emoji": "🔍", "title": "ラスタとベクタのちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🧩", "title": "ラスタ", "items": ["点の集まり", "拡大で劣化する"] },
              "right": { "icon": "📐", "title": "ベクタ", "items": ["数式で定義", "==拡大してもきれい=="] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🌡️", "title": "音のデジタル化のたとえ",
          "blocks": [
            { "t": "analogy", "icon": "🌡️",
              "real": "気温を **1 時間おき**に\nノートへ書きとめる。",
              "tech": "音の波も、一定間隔で値を取る。\nこれが ==標本化==。" }
          ]
        },
        {
          "emoji": "⏱️", "title": "標本化とは？",
          "blocks": [
            { "t": "big", "text": "**標本化** = 一定間隔で値を取る", "sub": "デジタル化のいちばん最初" }
          ]
        },
        {
          "emoji": "📏", "title": "つぎは「量子化」",
          "blocks": [
            { "t": "big", "text": "**量子化** = 有限ビットで近似", "sub": "「23.47℃」を「23℃」にする感じ" }
          ]
        },
        {
          "emoji": "🎵", "title": "音を数にする流れ",
          "blocks": [
            { "t": "anim", "caption": "▶ を押して 3 段階を見る",
              "frames": [
                { "visual": "🌊〜〜〜 連続の波", "text": "**標本化** … 0.01 秒ごとに値を取る" },
                { "visual": "📊 256 段階に丸める", "text": "**量子化** … ビット数で近似的に表す" },
                { "visual": "01001101…", "text": "**符号化** … 0 と 1 の列にする" }
              ] }
          ]
        },
        {
          "emoji": "🌊", "title": "デジタル化の順番",
          "blocks": [
            { "t": "flow", "stepwise": true, "steps": [
              { "label": "標本化", "sub": "間隔で取る" },
              { "label": "量子化", "sub": "ビットで近似" },
              { "label": "符号化", "sub": "0 と 1 に" }
            ], "caption": "==この順番== をおぼえる" }
          ]
        },
        {
          "emoji": "🗜️", "title": "圧縮は 2 種類",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🧳", "title": "可逆", "items": ["==元に戻せる==", "PNG / ZIP"] },
              "right": { "icon": "📝", "title": "非可逆", "items": ["情報を捨てる", "JPEG / MP3"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "拡大に強いのは **ベクタ（SVG）**。\nJPEG は ==非可逆圧縮==。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "ロゴを何度保存しても劣化させたくない。向くのは？",
              "choices": ["JPEG", "PNG", "MP3", "どれでも同じ"], "answer": 1,
              "explain": "**可逆圧縮**の PNG が向く。", "hint": "「元に戻せる」圧縮は？" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "デジタル化の順番で正しいのは？",
              "choices": ["量子化→標本化→符号化", "標本化→量子化→符号化", "符号化→標本化→量子化", "圧縮→標本化→量子化"],
              "answer": 1, "explain": "==標本化 → 量子化 → 符号化==。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**ラスタ** … 点の集まり", "**ベクタ** … 拡大してもきれい", "**標本化→量子化→符号化**"] }
          ]
        }
      ]
    },
    "63": {
      "slides": [
        {
          "layout": "title", "emoji": "🖱️", "title": "ヒューマンインタフェース",
          "subtitle": "人とコンピュータの\n「つなぎ方」を学ぼう。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🚪",
              "real": "お店の入り口。\n**絵の看板**か、**文字だけの案内**か。",
              "tech": "パソコンの操作画面も、\n見た目のちがいで使いやすさが変わる。" }
          ]
        },
        {
          "emoji": "🖱️", "title": "GUI とは？",
          "blocks": [
            { "t": "big", "text": "**GUI** = 絵で操作する画面", "sub": "アイコン・メニュー・マウス" }
          ]
        },
        {
          "emoji": "⌨️", "title": "CUI とは？",
          "blocks": [
            { "t": "big", "text": "**CUI** = 文字で命令する画面", "sub": "キーボードでコマンドを入力" }
          ]
        },
        {
          "emoji": "🔍", "title": "GUI と CUI のちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🖱️", "title": "GUI", "items": ["==視覚的==に操作", "初心者向き"] },
              "right": { "icon": "⌨️", "title": "CUI", "items": ["文字コマンド", "熟練者向き"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "♿", "title": "だれでも使える設計",
          "blocks": [
            { "t": "analogy", "icon": "🛗",
              "real": "駅のエレベーター。\n**子どももお年寄りも**使える。",
              "tech": "**ユニバーサルデザイン**。\n年齢・能力に関わらず使える設計。" }
          ]
        },
        {
          "emoji": "🌐", "title": "アクセシビリティ",
          "blocks": [
            { "t": "big", "text": "**アクセシビリティ** = 使えること", "sub": "障がいの有無に関わらず利用できる" }
          ]
        },
        {
          "emoji": "🔤", "title": "学校サイトの例",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "文字を大きくする",
              "before": "小さな薄いグレー文字",
              "after": "大きく・はっきりした文字",
              "afterLabel": "読みやすい",
              "why": "誰でも読める＝アクセシビリティの向上。" }
          ]
        },
        {
          "emoji": "📜", "title": "Web の国際指針",
          "blocks": [
            { "t": "big", "text": "Web の指針は **WCAG**", "sub": "アクセシビリティの国際的な基準" }
          ]
        },
        {
          "emoji": "⚠️", "title": "まちがえやすい点",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "ユニバーサルデザイン ≠ ただの「きれいな画面」。\n==だれでも使える== がポイント。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "GUI = **アイコンで視覚操作**。\nだれでも使える設計 = ==ユニバーサルデザイン==。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "マウスでアイコンをクリックする操作画面は？",
              "choices": ["CUI", "GUI", "CPU", "API"], "answer": 1,
              "explain": "絵で操作するのが **GUI**。", "hint": "「グラフィカル」の G。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "文字だけ大きくする工夫は、何を高める？",
              "choices": ["圧縮率", "アクセシビリティ", "標本化", "ベクタ化"],
              "answer": 1, "explain": "**アクセシビリティ**（使いやすさ）を高める。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**GUI** … 絵で操作", "**CUI** … 文字で命令", "**UD / アクセシビリティ** … だれでも"] }
          ]
        }
      ]
    }
  }
