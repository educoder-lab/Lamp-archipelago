    "13": {
      "slides": [
        {
          "layout": "title", "emoji": "🔎", "title": "配列と線形探索",
          "subtitle": "番号つきの箱を、\n端から順に見ていく。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🗄️",
              "real": "番号つきの靴箱。\n1 箱に 1 足。すき間なく一列。",
              "tech": "同じ形で、データを\n==一列にしまう== のが **配列**。" }
          ]
        },
        {
          "emoji": "📦", "title": "配列とは？",
          "blocks": [
            { "t": "big", "text": "**配列** = 同じ型の箱の列", "sub": "位置は番号で指定する" }
          ]
        },
        {
          "emoji": "🔢", "title": "その番号が「添字」",
          "blocks": [
            { "t": "big", "text": "**添字** = 箱の番号", "sub": "いちばん多いのは ==0 始まり==" }
          ]
        },
        {
          "emoji": "👀", "title": "配列を見てみよう",
          "blocks": [
            { "t": "array", "cells": ["30", "10", "50", "20"], "highlight": [2],
              "pointers": { "2": "A[2]" }, "caption": "0 始まりなら、3 番目の箱は添字 2" }
          ]
        },
        {
          "emoji": "🎴", "title": "探すときも、たとえから",
          "blocks": [
            { "t": "analogy", "icon": "🎴",
              "real": "伏せたカードを、\n左から 1 枚ずつめくる。",
              "tech": "これが ==線形探索==\n（先頭から順に探す）。" }
          ]
        },
        {
          "emoji": "➡️", "title": "線形探索のやり方",
          "blocks": [
            { "t": "flow", "steps": [
              { "label": "先頭を見る" },
              { "label": "同じ？", "sub": "違えば次へ" },
              { "label": "見つかるか終端" }
            ] }
          ]
        },
        {
          "emoji": "🐾", "title": "20 を探してみる",
          "blocks": [
            { "t": "trace", "vars": ["i", "A[i]", "一致？"],
              "rows": [["0", "30", "いいえ"], ["1", "10", "いいえ"], ["2", "50", "いいえ"], ["3", "20", "はい"]],
              "notes": ["次へ", "次へ", "次へ", "==見つかった=="] }
          ]
        },
        {
          "emoji": "⏱️", "title": "比べる回数の目安",
          "blocks": [
            { "t": "big", "text": "平均 およそ ==n/2== 回", "sub": "要素数 n に比例 → **O(n)**" }
          ]
        },
        {
          "emoji": "🪧", "title": "番兵法のたとえ",
          "blocks": [
            { "t": "analogy", "icon": "🪧",
              "real": "行列の最後に、\n探している人の看板を置く。",
              "tech": "**番兵**＝末尾のダミー。\n必ずそこで止まれる。" }
          ]
        },
        {
          "emoji": "✨", "title": "番兵の利点",
          "blocks": [
            { "t": "big", "text": "終了判定が ==かんたん== になる", "sub": "速さそのものは変わらない" }
          ]
        },
        {
          "emoji": "⚠️", "title": "よくあるまちがい",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "添字が **0 始まり**か **1 始まり**か。\n問題文を必ず見る。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "配列 8, 2, 6 で 6 を線形探索。何回目で見つかる？",
              "choices": ["1 回目", "2 回目", "3 回目", "4 回目"], "answer": 2,
              "explain": "8 → 2 → 6。==3 回目==。", "hint": "先頭から 1 つずつ。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**配列** … 一列の箱", "**線形探索** … 端から順に", "**番兵** … 終了判定を簡単に"] }
          ]
        }
      ]
    },
    "14": {
      "slides": [
        {
          "layout": "title", "emoji": "✂️", "title": "二分探索",
