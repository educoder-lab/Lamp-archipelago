    "106": {
      "slides": [
        {
          "layout": "title", "emoji": "⚖️", "title": "リスクアセスメント演習",
          "subtitle": "リスクを数字にして優先順位をつける。\n午後の定番の流れ。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🏠",
              "real": "台風の被害は、強さ × 家の弱さ ×\n**家財の価値**で決まる。",
              "tech": "**リスク値**＝脅威 × 脆弱性 × 資産価値。" }
          ]
        },
        {
          "emoji": "🧮", "title": "おぼえる式",
          "blocks": [
            { "t": "big", "text": "==脅威 × 脆弱性 × 資産価値==", "sub": "どれか 1 つが小さければリスクも小さい" }
          ]
        },
        {
          "emoji": "👤", "title": "脅威",
          "blocks": [
            { "t": "big", "text": "**脅威**＝害をなすもの", "sub": "攻撃者・マルウェア・災害など" }
          ]
        },
        {
          "emoji": "🕳️", "title": "脆弱性と資産価値",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🕳️", "title": "脆弱性", "items": ["守りの穴"] },
              "right": { "icon": "💎", "title": "資産価値", "items": ["大事さ"] },
              "vs": "×" }
          ]
        },
        {
          "emoji": "🐾", "title": "計算してみよう",
          "blocks": [
            { "t": "trace", "vars": ["資産", "脅威", "脆弱性", "価値", "リスク"],
              "rows": [["顧客 DB", "3", "2", "5", "30"], ["Web", "2", "3", "3", "18"], ["社内 PC", "2", "1", "2", "4"]],
              "notes": ["3×2×5＝30", "2×3×3＝18", "2×1×2＝4。優先は顧客 DB から"] }
          ]
        },
        {
          "emoji": "🧭", "title": "リスク対応は 4 つ",
          "blocks": [
            { "t": "cards", "items": [
              { "icon": "🚫", "title": "回避", "text": "やめる" },
              { "icon": "🛡️", "title": "軽減", "text": "下げる" },
              { "icon": "📦", "title": "転嫁", "text": "移す" },
              { "icon": "🤝", "title": "受容", "text": "受け入れる" }
            ] }
          ]
        },
        {
          "emoji": "🧪", "title": "状況で見分ける",
          "blocks": [
            { "t": "table", "head": ["したこと", "戦略"],
              "rows": [["サービス自体を中止", "回避"], ["暗号化を導入", "軽減"], ["保険に入る", "転嫁"], ["小さいので何もしない", "受容"]] }
          ]
        },
        {
          "emoji": "🔍", "title": "残余リスク",
          "blocks": [
            { "t": "analogy", "icon": "🦷",
              "real": "毎日歯みがきしても\n虫歯の心配は**ゼロにならない**。",
              "tech": "対策後に残るのが**残余リスク**。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "掛け算で大きい順に対策。\n動詞：やめる／下げる／移す／受け入れる。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "脅威 4、脆弱性 2、資産価値 3 のリスク値は？",
              "choices": ["9", "12", "24", "48"],
              "answer": 2, "explain": "4×2×3＝==24==。", "hint": "足し算ではなく掛け算。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "リスクが大きいのでサービス提供自体をやめた。これは？",
              "choices": ["回避", "軽減", "転嫁", "受容"],
              "answer": 0, "explain": "活動をやめる＝**回避**。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["リスク値＝**脅威×脆弱性×資産価値**", "対応は回避・軽減・転嫁・受容", "残るのが**残余リスク**"] }
          ]
        }
      ]
    },
    "107": {
      "slides": [
        {
          "layout": "title", "emoji": "🧬", "title": "暗号と認証の午後対策",
          "subtitle": "いいとこ取りの暗号から、\n改ざん検出・時刻証明まで。",
          "blocks": []
        },
        {
          "emoji": "🧳", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🧳",
              "real": "重い荷物は**速い金庫**へ。\n金庫の鍵だけ郵便受け方式で渡す。",
              "tech": "これが**ハイブリッド暗号**の発想。" }
          ]
        },
        {
          "emoji": "⚖️", "title": "なぜ組み合わせる？",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🔑", "title": "共通鍵", "items": ["速い", "渡しにくい"] },
              "right": { "icon": "📬", "title": "公開鍵", "items": ["遅い", "配りやすい"] },
              "vs": "補う" }
          ]
        },
        {
          "emoji": "📦", "title": "送信の流れ",
          "blocks": [
            { "t": "anim", "caption": "▶ ハイブリッド暗号",
              "frames": [
                { "visual": "🔑 共通鍵を作る", "text": "使い捨て" },
                { "visual": "📦 本文を共通鍵で", "text": "速く暗号化" },
                { "visual": "📬 共通鍵だけ公開鍵で", "text": "受信者の ==公開鍵==" }
              ] }
          ]
        },
        {
          "emoji": "🔓", "title": "受け取る側",
          "blocks": [
            { "t": "anim", "caption": "▶ 復号の順番",
              "frames": [
                { "visual": "🔐 **秘密鍵**", "text": "共通鍵を取り出す" },
                { "visual": "🔓 共通鍵", "text": "本文を復号" },
                { "visual": "📄 平文", "text": "公開鍵は ==鍵渡しだけ==" }
              ] }
          ]
        },
        {
          "emoji": "🏷️", "title": "MAC",
          "blocks": [
            { "t": "analogy", "icon": "📨",
              "real": "封筒に**合言葉入りの封印**。\n崩れていたら途中で開けられた。",
              "tech": "**MAC**＝改ざんを検出する認証データ。\n共有鍵から計算する。" }
          ]
        },
        {
          "emoji": "⏱️", "title": "タイムスタンプ",
          "blocks": [
            { "t": "analogy", "icon": "📮",
              "real": "郵便の**消印**。\nその日に存在したと第三者が証明。",
              "tech": "**タイムスタンプ**＝存在時刻の証明。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "隠す→暗号化。改ざん→MAC／署名。\n時刻→タイムスタンプ。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "ハイブリッド暗号で、暗号化した共通鍵を取り出す鍵は？",
              "choices": ["受信者の秘密鍵", "受信者の公開鍵", "送信者の秘密鍵", "ハッシュ値"],
              "answer": 0, "explain": "公開鍵で暗号化したので ==秘密鍵== で復号。", "hint": "郵便受けの鍵は持ち主。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "ハッシュ値だけ一緒に送る改ざん対策が弱い理由は？",
              "choices": ["長すぎる", "攻撃者が値も計算し直せる", "暗号化できない", "受信者が計算できない"],
              "answer": 1, "explain": "鍵がないので差し替え可能。**MAC**は共有鍵が要る。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["本文＝**共通鍵**、鍵渡し＝**公開鍵**", "**MAC**＝改ざん検出", "**タイムスタンプ**＝時刻証明"] }
          ]
        }
      ]
    },
    "108": {
      "slides": [
