{
  "domain": "fortress-algorithm",
  "lessons": {
    "90": {
      "slides": [
        {
          "layout": "title", "emoji": "✍️", "title": "科目Bトレース基礎",
          "subtitle": "コードを 1 行ずつ、\n変数の変化を追う。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🧾",
              "real": "家計簿。\nお金の出入りを 1 行ずつ書く。",
              "tech": "それが ==トレース==。\n変数の変化を記録する。" }
          ]
        },
        {
          "emoji": "📖", "title": "トレースとは？",
          "blocks": [
            { "t": "big", "text": "**1 行ずつ実行して追う**", "sub": "頭の中だけで飛ばさない" }
          ]
        },
        {
          "emoji": "📝", "title": "擬似言語の見た目",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "科目Bでよく見る形",
              "rows": [
                { "label": "代入", "value": "x ← 5" },
                { "label": "分岐", "value": "if x > 0 then …" }
              ],
              "why": "言語名より、**記号の意味**を読む。" }
          ]
        },
        {
          "emoji": "⬅️", "title": "矢印の意味",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "x ← 5",
              "rows": [
                { "label": "前", "value": "x = ？" },
                { "label": "後", "value": "x = ==5==", "hl": true }
              ],
              "why": "← は **入れる**。比較の = とは別。" }
          ]
        },
        {
          "emoji": "➕", "title": "自分を使う代入",
          "blocks": [
            { "t": "anim", "caption": "▶ x ← x + 1 の流れ",
              "frames": [
                { "visual": "x = **4**", "text": "いまの x を見る" },
                { "visual": "4 + 1 = 5", "text": "右辺を計算" },
                { "visual": "x = **5**", "text": "また x に入れる" }
              ] }
          ]
        },
        {
          "emoji": "📊", "title": "変数テーブルを使う",
          "blocks": [
            { "t": "analogy", "icon": "📊",
              "real": "名前と今の値を書く表。",
              "tech": "**変数テーブル**。\n変わるたびに書き直す。" }
          ]
        },
        {
          "emoji": "🐾", "title": "小さな例を追う",
          "blocks": [
            { "t": "trace", "vars": ["行", "x", "y"],
              "rows": [["開始", "?", "?"], ["x ← 3", "3", "?"], ["y ← x + 2", "3", "5"]],
              "notes": ["まだ空", "x に 3", "y は ==5=="] }
          ]
        },
        {
          "emoji": "🎯", "title": "いちばん大事なこと",
          "blocks": [
            { "t": "big", "text": "変数の変化を ==正確に== 追う", "sub": "速さより正確さ" }
          ]
        },
        {
          "emoji": "⚠️", "title": "よくあるまちがい",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "← を「比べる」と読まない。\n**入れる** の意味。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "表を書いて、\n1 行ごとに値を更新する。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "a ← 2 のあと a ← a × 3。a は？",
              "choices": ["2", "3", "5", "6"], "answer": 3,
              "explain": "2×3 = ==6==。", "hint": "今の a を使う。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["トレース … 1 行ずつ追う", "← … **代入**", "表に書いて確かめる"] }
          ]
        }
      ]
    },
    "91": {
      "slides": [
        {
          "layout": "title", "emoji": "🔁", "title": "トレース：繰返し",
          "subtitle": "条件が続くあいだ、\n同じ処理をくり返す。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🚶",
              "real": "「まだ届いていない」あいだ、\n歩き続ける。",
              "tech": "それが ==ループ（繰返し）==。" }
          ]
        },
        {
          "emoji": "📖", "title": "ループとは？",
          "blocks": [
            { "t": "big", "text": "条件が真のあいだくり返す", "sub": "偽になったら終わる" }
          ]
        },
        {
          "emoji": "🔢", "title": "ループカウンタ",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "i が 1 → 2 → 3",
              "rows": [
                { "label": "1 周目", "value": "i = 1" },
                { "label": "2 周目", "value": "i = 2" },
                { "label": "3 周目", "value": "i = ==3==", "hl": true }
              ],
              "why": "**i** が条件を満たすたびに進む。" }
          ]
        },
        {
          "emoji": "🐾", "title": "1〜3 を足す",
          "blocks": [
            { "t": "trace", "vars": ["i", "sum"],
              "rows": [["開始", "0"], ["i=1", "1"], ["i=2", "3"], ["i=3", "6"]],
              "notes": ["sum は 0", "+1", "+2", "+3 → ==6=="] }
          ]
        },
        {
          "emoji": "🛑", "title": "while が終わるとき",
          "blocks": [
            { "t": "anim", "caption": "▶ i ≤ 3 を追う",
              "frames": [
                { "visual": "i=1 … 真", "text": "中を実行して i++" },
                { "visual": "i=3 … 真", "text": "最後の 1 回" },
                { "visual": "i=4 … **偽**", "text": "ここで ==終了==" }
              ] }
          ]
        },
        {
          "emoji": "📦", "title": "二重ループのたとえ",
          "blocks": [
            { "t": "analogy", "icon": "📦",
              "real": "外側の箱が 1 つ進むたび、\n内側を全部やる。",
              "tech": "回数はだいたい\n==外側 × 内側==。" }
          ]
        },
        {
          "emoji": "✖️", "title": "回数の計算",
          "blocks": [
            { "t": "array", "cells": ["①", "②", "③", "④", "⑤", "⑥"],
              "start": 1, "highlight": [0, 1, 2, 3, 4, 5],
              "caption": "外 **2** × 内 **3** = ==6== 回（内側処理）" }
          ]
        },
        {
          "emoji": "⚠️", "title": "よくあるまちがい",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "カウンタの **初期値** と\n**終わりの条件** を飛ばさない。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "表で i と結果を追う。\n二重なら掛け算で回数確認。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "i を 1 から 3 まで、t ← t + 2（初期 t=0）。最終の t は？",
              "choices": ["3", "5", "6", "8"], "answer": 2,
              "explain": "0+2+2+2 = ==6==。", "hint": "3 回足す。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "外側 2 回・内側 5 回。内側処理の合計は？",
              "choices": ["7", "10", "5", "2"], "answer": 1,
              "explain": "2×5 = ==10== 回。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["ループ … 条件が真のあいだ", "while … **偽で終了**", "二重 … 外側×内側"] }
          ]
        }
      ]
    },
    "92": {
      "slides": [
        {
          "layout": "title", "emoji": "📦", "title": "トレース：配列操作",
          "subtitle": "番号つきの箱を、\n順に処理する。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🗄️",
              "real": "ロッカーを 1 番から順に開ける。",
              "tech": "配列の ==走査==。\n全要素を順に見る。" }
          ]
        },
        {
          "emoji": "🔢", "title": "科目Bの添字に注意",
          "blocks": [
            { "t": "big", "text": "擬似言語は ==1 始まり== が多い", "sub": "問題文の注意を必ず見る" }
          ]
        },
        {
          "emoji": "👀", "title": "配列を見る（1 始まり）",
          "blocks": [
            { "t": "array", "cells": ["10", "20", "30"], "start": 1,
              "highlight": [1], "pointers": { "1": "A[2]" },
              "caption": "A[2] = 20（1 始まり）" }
          ]
        },
        {
          "emoji": "🚶", "title": "走査の流れ",
          "blocks": [
            { "t": "anim", "caption": "▶ i で左から見る",
              "frames": [
                { "visual": "A[1]=10", "text": "i=1 を処理" },
                { "visual": "A[2]=20", "text": "i=2 へ" },
                { "visual": "A[3]=30", "text": "最後まで ==走査==" }
              ] }
          ]
        },
        {
          "emoji": "📈", "title": "最大値を探す",
          "blocks": [
            { "t": "array", "cells": ["4", "9", "7"], "start": 1,
              "highlight": [2], "pointers": { "2": "max=9" },
              "caption": "3 要素なら最大 **3** 回比べる（O(n)）" }
          ]
        },
        {
          "emoji": "🐾", "title": "最大値トレース",
          "blocks": [
            { "t": "trace", "vars": ["i", "A[i]", "max"],
              "rows": [["1", "4", "4"], ["2", "9", "9"], ["3", "7", "9"]],
              "notes": ["初期", "更新", "そのまま ==9=="] }
          ]
        },
        {
          "emoji": "🪧", "title": "番兵の思い出",
          "blocks": [
            { "t": "analogy", "icon": "🪧",
              "real": "末尾に目印を置く。",
              "tech": "**番兵**。\n終了判定がかんたんになる。" }
          ]
        },
        {
          "emoji": "✨", "title": "番兵の利点",
          "blocks": [
            { "t": "big", "text": "ループ終了判定の ==簡略化==", "sub": "計算量そのものは同じクラス" }
          ]
        },
        {
          "emoji": "⚠️", "title": "よくあるまちがい",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "0 始まりと 1 始まりを混ぜない。\n**A[1] が先頭**のことが多い。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "添字の始まりを確認。\n表で A[i] を追う。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "1 始まりで B=[5,15,25] のとき B[3] は？",
              "choices": ["5", "15", "25", "エラー"], "answer": 2,
              "explain": "1→5, 2→15, 3→==25==。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["科目Bは **1 始まり**が多い", "走査で全要素を処理", "番兵 … 終了判定を簡単に"] }
          ]
        }
      ]
    },
    "93": {
      "slides": [
        {
          "layout": "title", "emoji": "🪞", "title": "トレース：再帰",
          "subtitle": "関数が自分自身を呼び、\n小さくなるまで続く。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🪆",
              "real": "入れ子人形。\n中にもう一つ同じ形がある。",
              "tech": "それが ==再帰==。\n自分で自分を呼ぶ。" }
          ]
        },
        {
          "emoji": "📖", "title": "再帰とは？",
          "blocks": [
            { "t": "big", "text": "関数が **自分自身** を呼ぶ", "sub": "問題を小さくして渡す" }
          ]
        },
        {
          "emoji": "🛑", "title": "止まらないと困る",
          "blocks": [
            { "t": "big", "text": "**基底条件**（ベースケース）が必要", "sub": "これがないと終わらない" }
          ]
        },
        {
          "emoji": "📐", "title": "階乗のイメージ",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "f(3) の式",
              "before": "3 × f(2)",
              "after": "3 × 2 × 1 = **6**",
              "why": "n≤1 で ==1==（基底）に止まる。" }
          ]
        },
        {
          "emoji": "🌳", "title": "呼出しの木",
          "blocks": [
            { "t": "tree",
              "root": { "label": "f(3)",
                "children": [
                  { "label": "f(2)", "children": [{ "label": "f(1)=1" }] }
                ] },
              "caption": "小さくして、底で止まる" }
          ]
        },
        {
          "emoji": "🐾", "title": "戻りを追う",
          "blocks": [
            { "t": "trace", "vars": ["呼出し", "戻り値"],
              "rows": [["f(1)", "1"], ["f(2)", "2"], ["f(3)", "6"]],
              "notes": ["基底", "2×1", "3×2 = ==6=="] }
          ]
        },
        {
          "emoji": "📚", "title": "履歴はどこに？",
          "blocks": [
            { "t": "anim", "caption": "▶ 呼び出しの積み上げ",
              "frames": [
                { "visual": "f(3)", "text": "いちばん上" },
                { "visual": "f(2)", "text": "その下に f(2)" },
                { "visual": "f(1)=1", "text": "底で止まり、==下から戻る==" }
              ] }
          ]
        },
        {
          "emoji": "⚠️", "title": "終わらない条件",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "**基底条件がない**と、\n再帰は終わらない。" }
          ]
        },
        {
          "emoji": "🆚", "title": "再帰とループ",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🪞", "title": "再帰", "items": ["自分を呼ぶ", "基底で終わる"] },
              "right": { "icon": "🔁", "title": "ループ", "items": ["くり返す", "条件が偽で終わる"] },
              "vs": "似てる" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "呼出しを書く → 基底 →\n下から戻り値を計算。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "g(n): n=0 なら 0、それ以外は n+g(n-1)。g(3) は？",
              "choices": ["0", "3", "6", "9"], "answer": 2,
              "explain": "3+2+1+0 = ==6==。", "hint": "足し算の再帰。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "再帰の呼出し履歴を持つ構造は？",
              "choices": ["キュー", "スタック", "ハッシュ", "配列だけ"], "answer": 1,
              "explain": "コールスタックは ==スタック==。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["再帰 … 自分を呼ぶ", "**基底条件**で止まる", "履歴は **スタック**"] }
          ]
        }
      ]
    }
  }
}
