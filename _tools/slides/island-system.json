  "lessons": {
    "28": {
      "slides": [
        {
          "layout": "title", "emoji": "🛠️", "title": "システムの信頼性",
          "subtitle": "壊れにくさと直しやすさを、\n数字で見る。",
          "blocks": []
        },
        {
          "emoji": "🚲", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🚲",
              "real": "自転車は、走る → パンク → 直す。\nまた走る。",
              "tech": "システムも同じくり返し。\n動く時間と直す時間を測る。" }
          ]
        },
        {
          "emoji": "⏳", "title": "MTBF とは",
          "blocks": [
            { "t": "big", "text": "**MTBF** = 故障までの平均", "sub": "平均故障間隔。長いほど壊れにくい" }
          ]
        },
        {
          "emoji": "🔧", "title": "MTTR とは",
          "blocks": [
            { "t": "big", "text": "**MTTR** = 直す平均時間", "sub": "平均修復時間。短いほど早く戻る" }
          ]
        },
        {
          "emoji": "📐", "title": "稼働率の式",
          "blocks": [
            { "t": "big", "text": "稼働率 = MTBF ÷ (MTBF＋MTTR)", "sub": "1 に近いほど高信頼" }
          ]
        },
        {
          "emoji": "🧮", "title": "計算してみる",
          "blocks": [
            { "t": "steps", "items": [
              { "title": "例", "text": "MTBF=900、MTTR=100" },
              { "title": "分母", "text": "900＋100＝1000" },
              { "title": "割る", "text": "900÷1000＝==0.9==" }
            ] }
          ]
        },
        {
          "emoji": "🚦", "title": "フェールセーフ",
          "blocks": [
            { "t": "analogy", "icon": "🚦",
              "real": "信号が壊れたら、\n全部赤にして止める。",
              "tech": "**フェールセーフ** =\n故障時に ==安全な状態== へ。" }
          ]
        },
        {
          "emoji": "🔁", "title": "フォールトトレラント",
          "blocks": [
            { "t": "big", "text": "**フォールトトレラント**", "sub": "故障しても運用を続ける設計" }
          ]
        },
        {
          "emoji": "🔍", "title": "ちがいを見る",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🛑", "title": "フェールセーフ", "items": ["安全側に止める"] },
              "right": { "icon": "🔁", "title": "フォールトトレラント", "items": ["止めずに続ける"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "MTBF が大きいほど言えることは？",
              "choices": ["高速", "高信頼（壊れにくい）", "低コスト", "省電力"],
              "answer": 1, "explain": "故障間隔が長い → ==高信頼==。",
              "hint": "長く動ける。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "故障時に安全側へ止める設計は？",
              "choices": ["フォールトトレラント", "フェールセーフ", "ベンチマーク", "スループット"],
              "answer": 1, "explain": "安全に止めるのが **フェールセーフ**。",
              "hint": "信号を赤にするイメージ。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**MTBF** … 故障の間隔", "**稼働率** … MTBF÷(MTBF＋MTTR)", "**フェールセーフ** … 安全に止める"] }
          ]
        }
      ]
    },
    "29": {
      "slides": [
        {
          "layout": "title", "emoji": "🧩", "title": "冗長化と多重化",
          "subtitle": "予備を持って、\n止まらない仕組みをつくる。",
          "blocks": []
        },
        {
          "emoji": "🛞", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🛞",
              "real": "スペアタイヤがあれば、\nパンクしても走れる。",
              "tech": "**冗長化** = 同じ役目を\nあえて複数用意する。" }
          ]
        },
        {
          "emoji": "🏃", "title": "デュプレックス",
          "blocks": [
            { "t": "big", "text": "**デュプレックス** = 現用＋待機", "sub": "ふだんは現用系だけが働く" }
          ]
        },
        {
          "emoji": "👯", "title": "デュアル",
          "blocks": [
            { "t": "big", "text": "**デュアル** = 同時に同じ処理", "sub": "2 系統で答え合わせする" }
          ]
        },
        {
          "emoji": "🔍", "title": "ちがいを見る",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🏃", "title": "デュプレックス", "items": ["1 つが働き", "もう 1 つは控え"] },
              "right": { "icon": "👯", "title": "デュアル", "items": ["2 つが同時実行", "結果を照合"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🔥", "title": "ホットスタンバイ",
          "blocks": [
            { "t": "big", "text": "**ホット** = 温かい控え", "sub": "待機系が稼働中。==即座に切替え==" }
          ]
        },
        {
          "emoji": "❄️", "title": "コールドスタンバイ",
          "blocks": [
            { "t": "big", "text": "**コールド** = 冷えた控え", "sub": "待機系は停止。起動に時間がかかる" }
          ]
        },
        {
          "emoji": "🔗", "title": "直列の稼働率",
          "blocks": [
            { "t": "p", "text": "直列は **積**。\n0.9×0.8＝0.72。\nどこか 1 つ止まると全体が止まる。" }
          ]
        },
        {
          "emoji": "🔀", "title": "並列の稼働率",
          "blocks": [
            { "t": "big", "text": "並列 = 1−(1−A)(1−B)", "sub": "例：0.9 と 0.9 → ==0.99==" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "待機系が稼働中ですぐ切替えできるのは？",
              "choices": ["コールドスタンバイ", "ホットスタンバイ", "直列接続", "ストライピング"],
              "answer": 1, "explain": "**ホット**は温かい控えですぐ切替え。",
              "hint": "すでに動いている控え。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "稼働率 0.8 を 2 台直列にすると？",
              "choices": ["0.64", "0.8", "0.96", "1.6"], "answer": 0,
              "explain": "直列は積 → 0.8×0.8===0.64==。",
              "hint": "両方動いて初めて動く。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**デュプレックス** … 現用＋待機", "**ホット** … すぐ切替え", "**並列** … 1−(1−A)(1−B)"] }
          ]
        }
      ]
    },
