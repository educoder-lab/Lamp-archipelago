              "vs": "VS" }
          ]
        },
        {
          "emoji": "🔥", "title": "ホット vs コールド",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🔥", "title": "ホットスタンバイ", "items": ["控えも稼働中", "==即座に切替え=="] },
              "right": { "icon": "❄️", "title": "コールドスタンバイ", "items": ["控えは停止中", "起動に時間がかかる"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🔄", "title": "ホット切替えの流れ",
          "blocks": [
            { "t": "anim", "caption": "▶ を押して切替えを見る",
              "frames": [
                { "visual": "🟢 現用系が稼働中", "text": "ホット待機系は温かく待っている" },
                { "visual": "🔴 現用系が故障！", "text": "すぐに検知する" },
                { "visual": "🟢 待機系に切替え", "text": "ほぼ瞬時。ユーザーは気づかない" }
              ] }
          ]
        },
        {
          "emoji": "🔗", "title": "直列の稼働率",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "直列 2 台",
              "rows": [
                { "label": "サーバ A", "value": "稼働率 0.9" },
                { "label": "サーバ B", "value": "稼働率 0.8" },
                { "label": "直列（積）", "value": "0.9 × 0.8 = ==0.72==", "hl": true }
              ],
              "why": "どちらか 1 台でも止まれば全体が止まる。" }
          ]
        },
        {
          "emoji": "🔀", "title": "並列の稼働率",
          "blocks": [
            { "t": "big", "text": "並列 = **1 − (1−A)(1−B)**", "sub": "例：0.9 と 0.9 → 1−(0.1×0.1) = ==0.99==" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "待機系が稼働中ですぐ切替えできるのは？",
              "choices": ["コールドスタンバイ", "ホットスタンバイ", "直列接続", "デュアル"],
              "answer": 1, "explain": "**ホット**は温かい控えですぐ切替え。", "hint": "すでに動いている控え。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "稼働率 0.8 を 2 台直列にすると？",
              "choices": ["0.64", "0.8", "0.96", "1.6"], "answer": 0,
              "explain": "直列は積 → 0.8×0.8 = ==0.64==。", "hint": "両方動いて初めて動く。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**デュプレックス** … 現用＋待機", "**ホット** … すぐ切替え", "**並列** … 1−(1−A)(1−B)"] }
          ]
        }
      ]
    },
