    "28": {
      "slides": [
        {
          "layout": "title", "emoji": "🛠️", "title": "システムの信頼性",
          "subtitle": "壊れにくさと直しやすさを、\n数字で見る。",
          "blocks": []
        },
        {
          "emoji": "🚲", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🚲",
              "real": "自転車は「走る → パンク → 修理 → また走る」。\nこれが ==ずっとくり返す==。",
              "tech": "システムも同じ。\n動く時間と直す時間を測って評価する。" }
          ]
        },
        {
          "emoji": "🔋", "title": "MTBF のたとえ",
          "blocks": [
            { "t": "analogy", "icon": "🔋",
              "real": "充電式ライト。\n**長く光るほど**、すぐ電池を替えなくていい。",
              "tech": "MTBF が大きい = 故障の間隔が長い。" }
          ]
        },
        {
          "emoji": "⏳", "title": "MTBF とは",
          "blocks": [
            { "t": "big", "text": "**MTBF** = 故障までの平均時間", "sub": "長いほど壊れにくい（高信頼）" }
          ]
        },
        {
          "emoji": "🔧", "title": "MTTR とは",
          "blocks": [
            { "t": "big", "text": "**MTTR** = 直す平均時間", "sub": "短いほど早く元に戻る（高保守性）" }
          ]
        },
        {
          "emoji": "📐", "title": "稼働率の式",
          "blocks": [
            { "t": "big", "text": "稼働率 = **MTBF ÷ (MTBF＋MTTR)**", "sub": "1 に近いほど高信頼" }
          ]
        },
        {
          "emoji": "🧮", "title": "計算してみよう",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "稼働率を求める",
              "rows": [
                { "label": "MTBF（動いた）", "value": "900 時間" },
                { "label": "MTTR（修理）", "value": "100 時間" },
                { "label": "合計", "value": "1000 時間" },
                { "label": "稼働率", "value": "900 ÷ 1000 = ==0.9==", "hl": true }
              ],
              "why": "動いている時間だけ分子に乗る。" }
          ]
        },
        {
          "emoji": "🔄", "title": "故障〜修理のくり返し",
          "blocks": [
            { "t": "anim", "caption": "▶ を押して流れを見る",
              "frames": [
                { "visual": "🟢 稼働中", "text": "システムが動いている（MTBF の時間）" },
                { "visual": "🔴 故障！", "text": "何かが壊れた" },
                { "visual": "🔧 修理中", "text": "修理している（MTTR の時間）" },
                { "visual": "🟢 復旧！", "text": "また稼働。このくり返しが続く" }
              ] }
          ]
        },
        {
          "emoji": "🚦", "title": "フェールセーフ",
          "blocks": [
            { "t": "analogy", "icon": "🚦",
              "real": "信号が壊れたら、全部赤にして車を止める。",
              "tech": "**フェールセーフ** = 故障時に ==安全な状態== へ。" }
          ]
        },
        {
          "emoji": "🔁", "title": "フォールトトレラント",
          "blocks": [
            { "t": "big", "text": "**フォールトトレラント**", "sub": "故障しても運用を続ける設計" }
          ]
        },
        {
          "emoji": "🔍", "title": "2 つの考え方",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🛑", "title": "フェールセーフ", "items": ["安全側に==止める=="] },
              "right": { "icon": "🔁", "title": "フォールトトレラント", "items": ["止めずに ==続ける=="] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "MTBF が大きいほど言えることは？",
              "choices": ["高速", "高信頼（壊れにくい）", "低コスト", "省電力"],
              "answer": 1, "explain": "故障間隔が長い → ==高信頼==。", "hint": "長く動ける。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "故障時に安全側へ止める設計は？",
              "choices": ["フォールトトレラント", "フェールセーフ", "MTBF", "スループット"],
              "answer": 1, "explain": "安全に止めるのが **フェールセーフ**。", "hint": "信号を赤にするイメージ。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**MTBF** … 故障の間隔（長い＝高信頼）", "**稼働率** … MTBF÷(MTBF＋MTTR)", "**フェールセーフ** … 安全に止める"] }
          ]
        }
      ]
    },
    "29": {
      "slides": [
