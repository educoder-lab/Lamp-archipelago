        },
        {
          "emoji": "🔒", "title": "SSL/TLS の目的",
          "blocks": [
            { "t": "big", "text": "**通信の暗号化**と**相手の認証**", "sub": "https の正体。証明書を使う" }
          ]
        },
        {
          "emoji": "📜", "title": "証明書の確認（1）",
          "blocks": [
            { "t": "big", "text": "サーバが**証明書**を送る", "sub": "公開鍵つき" }
          ]
        },
        {
          "emoji": "🔍", "title": "証明書の確認（2）",
          "blocks": [
            { "t": "big", "text": "ブラウザが **CA の署名**を検証", "sub": "期限・サイト名も確認" }
          ]
        },
        {
          "emoji": "🎬", "title": "https の握手",
          "blocks": [
            { "t": "anim", "caption": "▶ 信頼できるサイト？",
