                { "visual": "証明書を受信", "text": "サーバが証明書を送る" },
                { "visual": "CA 署名チェック", "text": "ブラウザが ==CA の公開鍵== で検証" },
                { "visual": "鍵交換", "text": "OK なら暗号化通信開始" }
              ] }
          ]
        },
        {
