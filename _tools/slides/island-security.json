          ]
        },
        {
          "emoji": "⚠️", "title": "まちがえやすい点",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "パスワード＋秘密の質問は\nどちらも**知識**なので MFA ではない。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "パスワードとスマホのワンタイムコード。要素の組み合わせは？",
              "choices": ["知識＋所持", "知識＋生体", "所持＋生体", "知識＋知識"],
              "answer": 0, "explain": "パスワード＝知識、スマホ＝**所持**。", "hint": "知っている／持っている／体。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "証明書の CA 署名を検証する鍵は？",
              "choices": ["サイトの秘密鍵", "CA の公開鍵", "ブラウザの秘密鍵", "CA の秘密鍵"],
              "answer": 1, "explain": "署名の検証は ==CA の公開鍵==。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**CA**が証明書を発行", "**SSL/TLS**＝暗号化＋認証", "**MFA**＝異なる 2 種類以上"] }
          ]
        }
      ]
    },
