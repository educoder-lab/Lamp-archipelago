    "55": {
      "slides": [
        {
          "layout": "title", "emoji": "🔑", "title": "暗号化の基礎",
          "subtitle": "読めない形にして守る。\n鍵が 1 本か 2 本かがポイント。",
          "blocks": []
        },
        {
          "emoji": "📦", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "📦",
              "real": "手紙を**鍵つきの箱**に入れる。\n鍵がなければ中は読めない。",
              "tech": "読めない形にする＝**暗号化**。\n戻す＝**復号**。" }
          ]
        },
        {
          "emoji": "🔑", "title": "共通鍵暗号方式",
          "blocks": [
            { "t": "big", "text": "**同じ鍵**で暗号化も復号も", "sub": "例：AES。送る人も受け取る人も同じ鍵" }
          ]
        },
        {
          "emoji": "📤", "title": "共通鍵：送る",
          "blocks": [
            { "t": "big", "text": "鍵 K で**暗号文**にする", "sub": "途中で見られても読めない" }
          ]
        },
        {
          "emoji": "📥", "title": "共通鍵：受け取る",
          "blocks": [
            { "t": "big", "text": "同じ鍵 K で**復号**する", "sub": "弱点：鍵の受け渡しが難しい" }
          ]
        },
        {
          "emoji": "🎬", "title": "共通鍵の流れ",
          "blocks": [
            { "t": "anim", "caption": "▶ 同じ K",
              "frames": [
                { "visual": "平文", "text": "送信者が鍵 K で暗号化" },
                { "visual": "暗号文", "text": "途中は読めない" },
                { "visual": "平文", "text": "受信者も ==同じ K== で復号" }
              ] }
          ]
        },
        {
          "emoji": "📬", "title": "公開鍵暗号方式",
          "blocks": [
            { "t": "analogy", "icon": "📬",
              "real": "**郵便受け**。誰でも入れられる。\n取り出せるのは持ち主だけ。",
              "tech": "**公開鍵**と**秘密鍵**のペア。\n暗号化と復号で別の鍵を使う。" }
          ]
        },
        {
          "emoji": "🔐", "title": "公開鍵：暗号化する",
          "blocks": [
            { "t": "big", "text": "受信者の ==公開鍵== で暗号化", "sub": "公開鍵はみんなに配ってよい" }
          ]
        },
        {
          "emoji": "🔓", "title": "公開鍵：復号する",
          "blocks": [
            { "t": "big", "text": "受信者の ==秘密鍵== で復号", "sub": "本人しか読めない" }
          ]
        },
        {
          "emoji": "🧮", "title": "ハッシュ関数",
          "blocks": [
            { "t": "analogy", "icon": "🥤",
              "real": "ミキサーのジュース。\n**元の果物には戻せない**。",
              "tech": "**ハッシュ**＝固定長の値を作る\n一方向関数（例：SHA-256）。" }
          ]
        },
        {
          "emoji": "✍️", "title": "デジタル署名",
          "blocks": [
            { "t": "big", "text": "署名＝送信者の**秘密鍵**", "sub": "検証＝送信者の公開鍵" }
          ]
        },
        {
          "emoji": "📊", "title": "暗号化 vs 署名",
          "blocks": [
            { "t": "example", "label": "具体例",
              "rows": [
                { "label": "B だけに読ませる", "value": "B の ==公開鍵== で暗号化" },
                { "label": "A が送った証明", "value": "A の ==秘密鍵== で署名", "hl": true }
              ],
              "why": "向きが逆になるのでセットで覚える。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "「誰の」「どの鍵」まで聞かれる。\n暗号化と署名で向きが逆。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "A さんが B さんだけに読める手紙を送る。暗号化に使う鍵は？",
              "choices": ["B の公開鍵", "B の秘密鍵", "A の公開鍵", "A の秘密鍵"],
              "answer": 0, "explain": "暗号化は ==受信者の公開鍵==。", "hint": "郵便受けに入れるイメージ。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "SHA-256 は何に分類される？",
              "choices": ["共通鍵暗号", "公開鍵暗号", "ハッシュ関数", "乱数生成器"],
              "answer": 2, "explain": "SHA-256 は **ハッシュ関数**。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**共通鍵**＝同じ鍵 1 本", "**公開鍵**＝鍵のペア", "**署名**＝送信者の秘密鍵"] }
          ]
        }
      ]
    },
    "56": {
      "slides": [
        {
          "layout": "title", "emoji": "🪪", "title": "認証と証明書",
