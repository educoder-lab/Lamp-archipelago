{
  "domain": "island-corporate",
  "lessons": {
    "64": {
      "slides": [
        {
          "layout": "title", "emoji": "📊", "title": "財務と会計の基礎",
          "subtitle": "会社のお金の成績表を、\nかんたんに読めるようになろう。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "📒",
              "real": "おこづかい帳。\n**いくら入って、いくら使ったか**。",
              "tech": "会社にも、同じような成績表がある。" }
          ]
        },
        {
          "emoji": "📈", "title": "損益計算書（P/L）",
          "blocks": [
            { "t": "big", "text": "**P/L** = 一定期間のもうけ", "sub": "収益 − 費用 → 利益" }
          ]
        },
        {
          "emoji": "🏦", "title": "貸借対照表（B/S）",
          "blocks": [
            { "t": "big", "text": "**B/S** = ある時点の持ちもの", "sub": "資産・負債・純資産を示す" }
          ]
        },
        {
          "emoji": "🔍", "title": "P/L と B/S のちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "📈", "title": "P/L", "items": ["==期間==の成績", "もうけを見る"] },
              "right": { "icon": "🏦", "title": "B/S", "items": ["==時点==の残高", "持ちものを見る"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🛒", "title": "売上総利益",
          "blocks": [
            { "t": "big", "text": "**売上総利益** = 売上 − 原価", "sub": "商品そのもののもうけ" }
          ]
        },
        {
          "emoji": "🏢", "title": "営業利益",
          "blocks": [
            { "t": "big", "text": "**営業利益** = 本業のもうけ", "sub": "売上総利益 − 販管費" }
          ]
        },
        {
          "emoji": "⚖️", "title": "損益分岐点のたとえ",
          "blocks": [
            { "t": "analogy", "icon": "⚖️",
              "real": "屋台。売上が経費と\n**ちょうど同じ**だと、もうけゼロ。",
              "tech": "その点を ==損益分岐点== という。" }
          ]
        },
        {
          "emoji": "📍", "title": "損益分岐点とは？",
          "blocks": [
            { "t": "big", "text": "**損益分岐点** = 利益ゼロの点", "sub": "売上高と費用が等しい" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "売上 − 原価 = **売上総利益**。\n時点の資産・負債 = ==B/S==。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "1 か月のおこづかいの収支を表す書類に近いのは？",
              "choices": ["B/S", "P/L", "名刺", "取扱説明書"], "answer": 1,
              "explain": "**期間**の成績は P/L。", "hint": "「期間」か「時点」か。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "売上が費用と同じで、もうけがちょうどゼロ。何？",
              "choices": ["売上総利益", "営業利益", "損益分岐点", "純資産"],
              "answer": 2, "explain": "**損益分岐点**は利益ゼロの点。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**P/L** … 期間のもうけ", "**B/S** … 時点の持ちもの", "**損益分岐点** … 利益ゼロ"] }
          ]
        }
      ]
    },
    "65": {
      "slides": [
        {
          "layout": "title", "emoji": "©️", "title": "知的財産と法務",
          "subtitle": "アイデアや作品を守る\n「権利」の種類を知ろう。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🎨",
              "real": "自分で描いた絵。\n**書いた瞬間から**守られる感じ。",
              "tech": "創作物を守るのが **著作権**。" }
          ]
        },
        {
          "emoji": "©️", "title": "著作権とは？",
          "blocks": [
            { "t": "big", "text": "**著作権** = 創作物を守る", "sub": "==登録不要==。創作した時点で発生" }
          ]
        },
        {
          "emoji": "💡", "title": "特許権とは？",
          "blocks": [
            { "t": "big", "text": "**特許権** = 発明を守る", "sub": "出願・審査が必要" }
          ]
        },
        {
          "emoji": "🏷️", "title": "商標権とは？",
          "blocks": [
            { "t": "big", "text": "**商標権** = ブランドを守る", "sub": "名前やマークを保護" }
          ]
        },
        {
          "emoji": "🔍", "title": "著作権と特許のちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "©️", "title": "著作権", "items": ["創作物", "==登録不要=="] },
              "right": { "icon": "💡", "title": "特許権", "items": ["発明", "出願・審査あり"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🤫", "title": "営業秘密を守る法律",
          "blocks": [
            { "t": "analogy", "icon": "🔐",
              "real": "レシピを盗まれたら困る。\n**こっそり取るのはダメ**。",
              "tech": "**不正競争防止法**が、\n営業秘密の不正取得などを禁じる。" }
          ]
        },
        {
          "emoji": "💻", "title": "プログラムはどれで守る？",
          "blocks": [
            { "t": "big", "text": "プログラム → **著作権法**", "sub": "ソフトウェアのソースも創作物" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "著作権は ==創作した時点== で発生。\n発明の保護で審査が要るのは **特許権**。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "会社のロゴマークを守る権利は？",
              "choices": ["著作権", "特許権", "商標権", "肖像権"], "answer": 2,
              "explain": "ブランドのマークは **商標権**。", "hint": "名前やマーク。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "新しい発明を守るために必要なのは？",
              "choices": ["何もしなくてよい", "出願・審査", "SNS 投稿だけ", "社内メモだけ"],
              "answer": 1, "explain": "**特許権**は出願・審査が必要。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**著作権** … 創作物（登録不要）", "**特許権** … 発明（審査あり）", "**商標権** … ブランド"] }
          ]
        }
      ]
    },
    "66": {
      "slides": [
        {
          "layout": "title", "emoji": "📦", "title": "OR・在庫管理",
          "subtitle": "いちばんよい量・いちばん短い工期を\n数字で決める考え方。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🧃",
              "real": "ジュースの仕入れ。\n**多すぎても少なすぎても損**。",
              "tech": "最適な量を求めるのが、\nOR（オペレーションズリサーチ）の世界。" }
          ]
        },
        {
          "emoji": "📐", "title": "線形計画法（LP）",
          "blocks": [
            { "t": "big", "text": "**LP** = 制約の中で最適を探す", "sub": "利益を最大／費用を最小" }
          ]
        },
        {
          "emoji": "📦", "title": "EOQ（経済的発注量）",
          "blocks": [
            { "t": "analogy", "icon": "📦",
              "real": "注文の手間代と、倉庫代。\n**合計がいちばん安い回数**で買う。",
              "tech": "**EOQ**。発注費＋保管費を最小にする量。" }
          ]
        },
        {
          "emoji": "💰", "title": "EOQ で最小にする費用",
          "blocks": [
            { "t": "big", "text": "**発注費 ＋ 保管費** を最小に", "sub": "どちらか片方だけではない" }
          ]
        },
        {
          "emoji": "🗺️", "title": "PERT のたとえ",
          "blocks": [
            { "t": "analogy", "icon": "🗺️",
              "real": "料理の手順。\n「煮込んでいる間に切る」など **順番がある**。",
              "tech": "**PERT**。作業の依存を図にして\n最短工期を求める。" }
          ]
        },
        {
          "emoji": "🛤️", "title": "クリティカルパス",
          "blocks": [
            { "t": "big", "text": "**クリティカルパス** = 最長経路", "sub": "ここがプロジェクトの最短工期を決める" }
          ]
        },
        {
          "emoji": "⚠️", "title": "まちがえやすい点",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "クリティカルパスは「最短パス」ではない。\n==いちばん長い道== が工期を決める。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "制約下で利益最大 → **線形計画法**。\n最短工期を決める経路 → ==クリティカルパス==。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "材料と時間に限りがある中で、利益を最大にしたい。手法は？",
              "choices": ["標本化", "線形計画法", "著作権", "GUI"], "answer": 1,
              "explain": "制約下の最適化は **線形計画法**。", "hint": "制約の中で最適。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "PERT で工期を決める経路の特徴は？",
              "choices": ["いちばん短い", "いちばん長い", "ランダム", "関係ない"],
              "answer": 1, "explain": "**最長経路**がクリティカルパス。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**LP** … 制約下で最適", "**EOQ** … 発注＋保管を最小", "**クリティカルパス** … 最長経路"] }
          ]
        }
      ]
    },
