              "answer": 2,
              "explain": "1 − 0.3 × 0.5 = ==0.85==。",
              "hint": "全部止まる確率を 1 から引く。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
