          "blocks": []
        },
        {
          "emoji": "🏠", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🚲",
              "real": "自転車を買った。\n**代金だけでなく、修理代も**かかる。",
              "tech": "IT も、買ったあとの費用まで見る。" }
          ]
        },
        {
          "emoji": "📈", "title": "ROI とは？",
          "blocks": [
            { "t": "big", "text": "**ROI** = 投資利益率", "sub": "利益 ÷ 投資額 × 100" }
          ]
        },
        {
          "emoji": "📈", "title": "ROI が大きいと？",
          "blocks": [
            { "t": "big", "text": "ROI が大きい = **投資効果が高い**", "sub": "同じ投資でも、もうけが大きい" }
          ]
        },
        {
          "emoji": "🧾", "title": "TCO とは？",
          "blocks": [
            { "t": "analogy", "icon": "🧾",
              "real": "導入から捨てるまで。\n**ぜんぶの費用**を足す。",
              "tech": "**TCO**（総所有コスト）。全期間の総コスト。" }
          ]
        },
        {
          "emoji": "🧾", "title": "TCO（一言）",
          "blocks": [
            { "t": "big", "text": "**TCO** = 導入〜廃棄の総コスト", "sub": "買うお金だけではない" }
          ]
        },
        {
          "emoji": "🔍", "title": "ROI と TCO のちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "📈", "title": "ROI", "items": ["効果の割合", "==もうけ効率=="] },
              "right": { "icon": "🧾", "title": "TCO", "items": ["総コスト", "期間全体の費用"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🏛️", "title": "EA とは？",
          "blocks": [
            { "t": "big", "text": "**EA** = 組織全体の設計図", "sub": "業務と IT を 4 つの体系で見る" }
          ]
        },
        {
          "emoji": "🧱", "title": "EA の 4 体系",
          "blocks": [
            { "t": "layers", "top": "業務側", "bottom": "技術側",
