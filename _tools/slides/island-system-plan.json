          ]
        },
        {
          "emoji": "📚", "title": "共通フレーム",
          "blocks": [
            { "t": "big", "text": "**共通フレーム** = 標準プロセス体系", "sub": "ソフトウェアライフサイクル（JIS X 0160）" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
