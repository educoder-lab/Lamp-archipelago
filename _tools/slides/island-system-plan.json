{
  "domain": "island-system-plan",
  "lessons": {
    "72": {
      "slides": [
        {
          "layout": "title", "emoji": "📋", "title": "システム企画と要件定義",
          "subtitle": "作る前に決めること。\n「何を・どれくらい」をはっきりさせよう。",
          "blocks": []
        },
        {
          "emoji": "🏠", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🏠",
              "real": "家を建てる前に「何部屋・予算いくら」を決める。\n後から変えると大工事になる。",
              "tech": "システムも同じ。企画と要件を先に固める。" }
          ]
        },
        {
          "emoji": "🗺️", "title": "システム化計画とは？",
          "blocks": [
            { "t": "big", "text": "**システム化計画** = IT 投資の方針", "sub": "課題と優先度を決め、ゴールを描く" }
          ]
        },
        {
          "emoji": "📝", "title": "要件定義とは？",
          "blocks": [
            { "t": "big", "text": "**要件定義** = 求める機能・性能を明確化", "sub": "「作るものの約束」を文章にする" }
          ]
        },
        {
          "emoji": "⚙️", "title": "機能要件とは？",
          "blocks": [
            { "t": "analogy", "icon": "📱",
              "real": "校内ポータルで\n「成績を見る」「課題を出す」ができる。",
              "tech": "**機能要件** = 何ができるか（処理・画面）。" }
          ]
        },
        {
          "emoji": "⏱️", "title": "非機能要件とは？",
          "blocks": [
            { "t": "big", "text": "**非機能要件** = どれくらいの品質か", "sub": "性能・信頼性・セキュリティなど" }
          ]
        },
        {
          "emoji": "🔍", "title": "機能 vs 非機能",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "通販サイトで比べる",
              "rows": [
                { "label": "機能要件", "value": "「商品検索ができる」「注文できる」" },
                { "label": "非機能要件", "value": "「3 秒以内に検索結果が返る」", "hl": true }
              ],
              "why": "「何ができるか」が機能、「どれくらい速く確実か」が非機能。" }
          ]
        },
        {
          "emoji": "🔬", "title": "フィジビリティスタディ",
          "blocks": [
            { "t": "analogy", "icon": "🔬",
              "real": "遠足の下見。「本当にそのルートで行けるか」を先に確かめる。",
              "tech": "**フィジビリティスタディ**。実現可能性を事前に調査すること。" }
          ]
        },
        {
          "emoji": "🧱", "title": "要件定義の手順",
          "blocks": [
            { "t": "flow", "stepwise": true, "steps": [
              { "label": "業務を理解", "sub": "今の仕事の流れを把握" },
              { "label": "課題を整理", "sub": "何が困っているか" },
              { "label": "機能を決める", "sub": "機能要件・非機能要件" },
              { "label": "合意する", "sub": "依頼者と書面で確認" }
            ], "caption": "この順番で進める" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "処理・入出力 = **機能要件**。\n応答時間など = ==非機能要件==。\n実現性調査 = **フィジビリティスタディ**。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "「ログインできる」はどの要件に近い？",
              "choices": ["非機能要件", "機能要件", "ROI", "SLA"], "answer": 1,
              "explain": "「何ができるか」は **機能要件**。", "hint": "できることか、品質か。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "「同時接続 1000 人でも落ちない」は？",
              "choices": ["機能要件", "非機能要件", "著作権", "4P"],
              "answer": 1, "explain": "性能・信頼性は **非機能要件**。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**機能要件** … 何ができるか", "**非機能要件** … 品質の水準", "**フィジビリティ** … 実現できるか"] }
          ]
        }
      ]
    },
    "73": {
      "slides": [
        {
          "layout": "title", "emoji": "💹", "title": "IT 投資評価",
          "subtitle": "「いくらかけて、どれだけ効いたか」を\n測るものさしを学ぼう。",
          "blocks": []
        },
        {
          "emoji": "🚲", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🚲",
              "real": "自転車を買った。代金だけでなく、修理代・保険料もかかる。\n売るときは下取り値段も関係する。",
              "tech": "IT も、買ったあとの費用まで全部見る。" }
          ]
        },
        {
          "emoji": "📈", "title": "ROI とは？",
          "blocks": [
            { "t": "big", "text": "**ROI** = 投資利益率", "sub": "利益 ÷ 投資額 × 100 (%)" }
          ]
        },
        {
          "emoji": "🧮", "title": "ROI の計算例",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "ROI を求める",
              "rows": [
                { "label": "投資額", "value": "100 万円" },
                { "label": "得られた利益", "value": "30 万円" },
                { "label": "ROI", "value": "30 ÷ 100 × 100 = ==30%==", "hl": true }
              ],
              "why": "ROI が大きいほど、投資効果が高い。" }
          ]
        },
        {
          "emoji": "🧾", "title": "TCO とは？",
          "blocks": [
            { "t": "analogy", "icon": "🧾",
              "real": "車の「総維持費」。車体代 + ガソリン + 修理 + 保険 + 廃車まで。",
              "tech": "**TCO**（総所有コスト）= 導入〜廃棄までの全コスト。" }
          ]
        },
        {
          "emoji": "🧾", "title": "TCO の内訳イメージ",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "PC 1 台の 5 年間 TCO",
              "rows": [
                { "label": "購入費", "value": "10 万円" },
                { "label": "保守・修理", "value": "3 万円" },
                { "label": "サポート人件費", "value": "5 万円" },
                { "label": "TCO 合計", "value": "==18 万円==", "hl": true }
              ],
              "why": "「本体だけ安い」でも、維持費が高いと TCO は大きくなる。" }
          ]
        },
        {
          "emoji": "🔍", "title": "ROI と TCO のちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "📈", "title": "ROI", "items": ["効果の ==割合==", "大きいほど良い"] },
              "right": { "icon": "🧾", "title": "TCO", "items": ["全期間の ==コスト==", "小さいほど良い"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🏛️", "title": "EA とは？",
          "blocks": [
            { "t": "big", "text": "**EA** = 組織全体の IT 設計図", "sub": "業務と IT を 4 つの体系で整理する" }
          ]
        },
        {
          "emoji": "🧱", "title": "EA の 4 体系",
          "blocks": [
            { "t": "layers", "top": "業務側", "bottom": "技術側",
              "items": [
                { "icon": "🏢", "label": "ビジネス（業務）" },
                { "icon": "📊", "label": "データ" },
                { "icon": "💻", "label": "アプリケーション" },
                { "icon": "🔌", "label": "テクノロジ（インフラ）" }
              ], "caption": "==マーケティングは入らない==" }
          ]
        },
        {
          "emoji": "📚", "title": "共通フレーム",
          "blocks": [
            { "t": "big", "text": "**共通フレーム** = 標準プロセス体系", "sub": "ソフトウェアライフサイクル（JIS X 0160）" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "全期間コスト = **TCO**。\nROI 大 = ==投資効果が高い==。\nEA にマーケティングは入らない。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "買ったあとの運用・修理・廃棄まで足した費用は？",
              "choices": ["ROI", "TCO", "GUI", "RFP"], "answer": 1,
              "explain": "全期間の総コストは **TCO**。", "hint": "Total の T。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "ROI が大きいほど言えることは？",
              "choices": ["コストが高い", "投資効果が高い", "期間が長い", "リスクがゼロ"],
              "answer": 1, "explain": "ROI 大 = **投資効果が高い**。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**ROI** … 投資効果の割合", "**TCO** … 全期間コスト", "**EA** … 4 体系の設計図"] }
          ]
        }
      ]
    }
  }
}
