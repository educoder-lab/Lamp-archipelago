              "tech": "**バイト** = ビット 8 個のかたまり" }
          ]
        },
        {
          "emoji": "📦", "title": "おぼえる式",
          "blocks": [
            { "t": "big", "text": "==1 バイト = 8 ビット==" }
          ]
        },
        {
          "emoji": "🚚", "title": "「ワード」とは？",
          "blocks": [
            { "t": "analogy", "icon": "🚚",
              "real": "トラックの荷台の大きさ。",
              "tech": "**ワード** = CPU が一度に運ぶ量\n（32 ビットや 64 ビット）" }
          ]
        },
        {
          "emoji": "🔍", "title": "バイトとワードのちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "📦", "title": "バイト", "items": ["==いつも 8 ビット=="] },
              "right": { "icon": "🚚", "title": "ワード", "items": ["CPU で変わる"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🧱", "title": "大きさの順番",
          "blocks": [
            { "t": "layers", "top": "大きい", "bottom": "小さい",
