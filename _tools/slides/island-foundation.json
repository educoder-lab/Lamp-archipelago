          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "2 進 1111 0000 は 16 進で？",
              "choices": ["0F", "F0", "FF", "F"], "answer": 1,
              "explain": "1111→F、0000→0 → ==F0==。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["2→10 … **重みを足す**", "10→2 … **2 で割る**（下から）", "16 進 … **4 ビット = 1 桁**"] }
