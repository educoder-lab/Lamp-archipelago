        },
        {
          "emoji": "🏠", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "💡",
              "real": "部屋のスイッチ。\n**ON** か **OFF** だけ。",
              "tech": "コンピュータも同じ。\n電気の ==あり / なし== で動く。" }
          ]
        },
        {
          "emoji": "🔘", "title": "それが「ビット」",
          "blocks": [
            { "t": "big", "text": "**ビット** = スイッチ 1 個", "sub": "0 か 1。いちばん小さい単位" }
          ]
        },
        {
          "emoji": "👆", "title": "さわってみよう",
          "blocks": [
            { "t": "bits", "bits": "1", "weights": false, "caption": "クリックで 0 ↔ 1" }
          ]
        },
        {
          "emoji": "📈", "title": "スイッチをふやすと？",
          "blocks": [
            { "t": "table", "head": ["個数", "通り"], "rows": [["1", "2"], ["2", "4"], ["3", "8"], ["8", "256"]], "highlight": [3], "caption": "1 個ふえるたび ==2 倍==" }
          ]
        },
        {
          "emoji": "📦", "title": "8 個まとめると「バイト」",
          "blocks": [
            { "t": "analogy", "icon": "✏️",
