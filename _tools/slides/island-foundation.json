              "answer": 2, "explain": "**バイト**はいつも 8 ビット。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**ビット** … 0 か 1", "**バイト** … 8 ビット", "**ワード** … CPU の運ぶ量"] }
          ]
        }
      ]
    },
    "2": {
      "slides": [
        {
          "layout": "title", "emoji": "🔁", "title": "基数変換",
          "subtitle": "同じ数を、\n別の書き方で言い換える。",
          "blocks": []
        },
        {
          "emoji": "🗣️", "title": "たとえ話",
          "blocks": [
            { "t": "analogy", "icon": "🌏",
              "real": "「こんにちは」も「Hello」も、\n**意味は同じ**。",
              "tech": "数も同じ。書き方だけ違う。\nこれを ==基数変換== という。" }
          ]
        },
        {
          "emoji": "👀", "title": "同じ「10」を見てみる",
          "blocks": [
            { "t": "table", "head": ["10 進", "2 進", "16 進"],
              "rows": [["10", "1010", "A"], ["15", "1111", "F"]],
              "caption": "量は同じ。見た目だけ違う" }
          ]
        },
        {
          "emoji": "🔟", "title": "10 進数はおなじみ",
          "blocks": [
            { "t": "big", "text": "**10 進** = 0〜9 の 10 個", "sub": "10 で桁が上がる（ふだんの数）" }
          ]
        },
        {
          "emoji": "🔘", "title": "2 進数は 0 と 1 だけ",
          "blocks": [
            { "t": "big", "text": "**2 進** = 0 と 1 だけ", "sub": "2 で桁が上がる" }
          ]
        },
        {
          "emoji": "➕", "title": "2 進 → 10 進のコツ",
          "blocks": [
            { "t": "p", "text": "右から重みは ==1, 2, 4, 8==。\n**1 の桁だけ足す**。" }
          ]
        },
        {
          "emoji": "👆", "title": "やってみよう",
          "blocks": [
            { "t": "bits", "bits": "1011", "caption": "クリックで切り替え → 下に 10 進が出る" }
          ]
        },
        {
          "emoji": "➗", "title": "10 進 → 2 進のコツ",
          "blocks": [
            { "t": "big", "text": "**2 で割って、あまりを集める**", "sub": "あまりは ==下から上へ== 読む" }
          ]
        },
        {
          "emoji": "🐾", "title": "12 → 2 進（1 歩ずつ）",
          "blocks": [
            { "t": "trace", "vars": ["数", "商", "あまり"],
              "rows": [["12", "6", "0"], ["6", "3", "0"], ["3", "1", "1"], ["1", "0", "1"]],
              "notes": ["12÷2 → あまり 0", "6÷2 → あまり 0", "3÷2 → あまり 1", "終わり。下から読むと ==1100=="] }
          ]
        },
        {
          "emoji": "🔡", "title": "16 進は A〜F も使う",
          "blocks": [
            { "t": "table", "head": ["10", "11", "12", "13", "14", "15"],
              "rows": [["A", "B", "C", "D", "E", "F"]],
              "caption": "==A=10 … F=15==。おぼえるだけ" }
          ]
        },
        {
          "emoji": "✂️", "title": "2 進 ↔ 16 進は区切る",
          "blocks": [
            { "t": "flow", "steps": [
              { "label": "1111 0000", "sub": "2 進" },
              { "label": "F 0", "sub": "4 桁ずつ → 16 進" }
            ], "caption": "==4 ビット = 16 進 1 桁==" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "2 進 0110 は 10 進で？",
              "choices": ["4", "6", "8", "10"], "answer": 1,
              "explain": "4+2 = ==6==。", "hint": "右から 1,2,4,8。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "2 進 1111 0000 は 16 進で？",
              "choices": ["0F", "F0", "FF", "F"], "answer": 1,
              "explain": "1111→F、0000→0 → ==F0==。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["2→10 … **重みを足す**", "10→2 … **2 で割る**（下から）", "16 進 … **4 ビット = 1 桁**"] }
          ]
        }
      ]
    }
  }
