                { "icon": "🚚", "label": "ワード" },
                { "icon": "📦", "label": "バイト（8 ビット）" },
                { "icon": "🔘", "label": "ビット" }
              ] }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "スイッチ 4 個で、何通り？",
              "choices": ["8", "12", "16", "32"], "answer": 2,
              "explain": "2×2×2×2 = ==16== 通り。", "hint": "1 個ふえると 2 倍。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "バイトとワード、正しいのは？",
