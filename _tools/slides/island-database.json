        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**SELECT** … 取り出す",
              "**WHERE / LIKE** … 条件",
              "**ORDER BY / DISTINCT** … 並びと重複"
            ] }
          ]
        }
      ]
    },
    "43": {
      "slides": [
        {
          "layout": "title", "emoji": "🤝", "title": "SQL 結合と副問合せ",
          "subtitle": "複数の表をつなぎ、\n入れ子の問い合わせも使う。",
          "blocks": []
        },
        {
          "emoji": "🧩", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "📇",
              "real": "顧客名簿と注文票を\n**同じ番号で合わせる**。",
              "tech": "**結合（JOIN）** =\n複数テーブルを条件でつなぐ" }
          ]
        },
        {
          "emoji": "⌨️", "title": "内部結合の書き方",
          "blocks": [
            { "t": "code", "lang": "sql",
              "text": "SELECT *\nFROM 顧客\nINNER JOIN 注文\n  ON 顧客.ID = 注文.顧客ID;" }
          ]
        },
        {
          "emoji": "🎯", "title": "INNER JOIN の意味",
          "blocks": [
            { "t": "big", "text": "**INNER JOIN** = 一致する行だけ", "sub": "両テーブルに相手がいる行" }
          ]
        },
        {
          "emoji": "🌤️", "title": "OUTER JOIN",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🎯", "title": "INNER", "items": ["一致だけ"] },
              "right": { "icon": "🌤️", "title": "OUTER", "items": ["不一致も NULL で残す"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🪆", "title": "副問合せ",
          "blocks": [
            { "t": "big", "text": "**副問合せ** = SELECT の入れ子", "sub": "SQL の中に別の SELECT" }
          ]
        },
        {
          "emoji": "🎬", "title": "JOIN の結果",
          "blocks": [
            { "t": "anim", "caption": "▶ 一致行だけ",
              "frames": [
                { "visual": "顧客|注文", "text": "2 つの表を用意" },
                { "visual": "ON 顧客.ID=…", "text": "キーが一致する行を結ぶ" },
                { "visual": "INNER", "text": "片方にだけある行は ==出ない==" }
              ] }
          ]
        },
        {
          "emoji": "📦", "title": "GROUP BY",
          "blocks": [
            { "t": "big", "text": "**GROUP BY** = グループ化して集約", "sub": "合計・件数などをまとめる" }
          ]
        },
        {
          "emoji": "🔎", "title": "HAVING",
          "blocks": [
            { "t": "callout", "kind": "tip",
              "text": "**HAVING** は\nGROUP BY の**あと**を絞り込む。\nWHERE は集約前。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "両表で一致する行だけ返す結合は？",
              "choices": ["CROSS JOIN", "INNER JOIN", "LEFT JOIN", "FULL JOIN"],
              "answer": 1, "explain": "**INNER JOIN** は一致行のみ。",
              "hint": "内側の一致。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "集計結果をさらに絞る句は？",
              "choices": ["WHERE", "ORDER BY", "HAVING", "LIMIT"],
              "answer": 2, "explain": "集約後は **HAVING**。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "一致だけ → **INNER**\n入れ子 SELECT → **副問合せ**\n集約後の条件 → **HAVING**" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**INNER / OUTER** … 結合の種類",
              "**副問合せ** … 入れ子",
              "**GROUP BY / HAVING** … 集約と絞り"
            ] }
          ]
        }
      ]
    },
