    "45": {
      "slides": [
        {
          "layout": "title", "emoji": "💳", "title": "トランザクションと障害回復",
          "subtitle": "一連の処理をまとめ、\n失敗しても元に戻せる。",
          "blocks": []
        },
        {
          "emoji": "🏦", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "💸",
              "real": "振込は「引く＋入れる」。\n片方だけだと**困る**。",
              "tech": "**トランザクション** =\n一連処理の不可分な単位" }
          ]
        },
        {
          "emoji": "⚛️", "title": "原子性（A）",
          "blocks": [
            { "t": "big", "text": "**原子性** = 全部か、全部なし", "sub": "ACID の A。途中で終わらない" }
          ]
        },
        {
