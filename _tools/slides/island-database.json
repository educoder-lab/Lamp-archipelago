  "lessons": {
    "40": {
      "slides": [
        {
          "layout": "title", "emoji": "📊", "title": "関係データベースの基礎",
          "subtitle": "データを「表」で管理する\n考え方を知る。",
          "blocks": []
        },
        {
          "emoji": "📋", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "📒",
              "real": "名簿や成績表のような\n**マス目のある表**。",
              "tech": "**RDB** =\nデータをテーブル（表）で管理する DB" }
          ]
        },
        {
          "emoji": "🧾", "title": "テーブルとは？",
          "blocks": [
            { "t": "big", "text": "**テーブル** = 行と列のかたまり", "sub": "行=レコード、列=カラム" }
          ]
        },
        {
          "emoji": "👀", "title": "表の見た目",
          "blocks": [
            { "t": "table", "head": ["学籍番号", "名前"],
              "rows": [["1001", "山田"], ["1002", "佐藤"]],
              "caption": "横が ==行==、縦が ==列==" }
          ]
        },
        {
          "emoji": "🔑", "title": "主キー",
          "blocks": [
            { "t": "big", "text": "**主キー** = 行をひとりに決める列", "sub": "重複なし・NULL 不可" }
          ]
        },
        {
          "emoji": "🔗", "title": "外部キー",
          "blocks": [
            { "t": "analogy", "icon": "📎",
              "real": "注文票に書く\n**お客様番号**（名簿を指す）。",
              "tech": "**外部キー** =\n他テーブルの主キーを参照する列" }
          ]
        },
        {
          "emoji": "🧩", "title": "2 つの表をつなぐ",
          "blocks": [
            { "t": "flow", "stepwise": true, "steps": [
              { "label": "顧客表", "sub": "主キー: 顧客ID" },
              { "label": "注文表", "sub": "外部キー: 顧客ID" }
            ], "caption": "参照整合性を保つ" }
          ]
        },
        {
          "emoji": "🎬", "title": "注文 1001 号",
          "blocks": [
            { "t": "anim", "caption": "▶ 外部キーでつなぐ",
              "frames": [
                { "visual": "顧客 1001=山田", "text": "主キーで人を特定" },
                { "visual": "注文 5001", "text": "顧客ID=1001 を書く" },
                { "visual": "参照OK", "text": "存在しない ID は ==エラー==" }
              ] }
          ]
        },
        {
          "emoji": "⚠️", "title": "主キーの約束",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "主キーは ==一意かつ NOT NULL==。\n空や重複はダメ。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "RDB でデータを入れる入れ物の名前は？",
              "choices": ["グラフ", "テーブル", "キュー", "スタック"],
              "answer": 1, "explain": "関係 DB は **テーブル** に格納。",
              "hint": "表のこと。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "他表の主キーを指す列は？",
              "choices": ["候補キー", "外部キー", "代理キー", "索引"],
              "answer": 1, "explain": "**外部キー**が他表を参照する。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "主キー → **一意・NULL 不可**\n他表参照 → **外部キー**" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**RDB / テーブル** … 表で管理",
              "**主キー** … 行の名刺",
              "**外部キー** … 他表への指差し"
            ] }
          ]
        }
      ]
    },
    "41": {
      "slides": [
        {
          "layout": "title", "emoji": "🧹", "title": "正規化",
          "subtitle": "同じデータの重複を減らし\n表をきれいに分ける。",
          "blocks": []
        },
        {
          "emoji": "🧺", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "📝",
              "real": "1 枚の紙に住所を何度も書くと、\n**書き直しが大変**。",
              "tech": "**正規化** =\n冗長性を排し、テーブルを分割する" }
          ]
        },
        {
          "emoji": "🎯", "title": "目的はひとつ",
          "blocks": [
            { "t": "big", "text": "目的は ==データ冗長性の排除==", "sub": "同じ事実を何度も持たない" }
          ]
        },
        {
          "emoji": "1️⃣", "title": "第1正規形",
          "blocks": [
            { "t": "big", "text": "**第1正規形** = 繰返しをやめる", "sub": "どの列も原子的な（1 つの）値" }
          ]
        },
        {
          "emoji": "2️⃣", "title": "第2正規形",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "複合キー",
              "before": "（学籍,科目）→担任名",
              "after": "科目だけでは？→担任が決まる",
              "afterLabel": "部分従属",
              "why": "主キーの ==一部だけ== に従う情報を分離。" }
          ]
        },
        {
          "emoji": "3️⃣", "title": "第3正規形",
          "blocks": [
            { "t": "example", "label": "具体例",
              "rows": [
                { "label": "学籍→学部", "value": "OK" },
                { "label": "学部→学部長", "value": "推移従属 → ==表を分ける==", "hl": true }
              ],
              "why": "間接的に決まる情報を別テーブルへ。" }
          ]
        },
        {
          "emoji": "➡️", "title": "段階の流れ",
          "blocks": [
            { "t": "flow", "stepwise": true, "steps": [
              { "label": "1NF", "sub": "繰返し除去" },
              { "label": "2NF", "sub": "部分従属除去" },
              { "label": "3NF", "sub": "推移従属除去" }
            ] }
          ]
        },
        {
          "emoji": "🎬", "title": "電話番号の列",
          "blocks": [
            { "t": "anim", "caption": "▶ 1NF へ",
              "frames": [
                { "visual": "電話1|電話2", "text": "繰返し列 … 非正規" },
                { "visual": "別テーブルへ", "text": "1 行 1 電話に分割" },
                { "visual": "1NF 達成", "text": "各マスは ==1 つの値==" }
              ] }
          ]
        },
        {
          "emoji": "⚠️", "title": "注意",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "正規化の主目的は\n**冗長性の排除**（速度向上が第一ではない）。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "「電話番号が複数マスに並ぶ」を直すと？",
              "choices": ["非正規のまま", "第1正規形", "第3正規形だけ", "索引追加"],
              "answer": 1, "explain": "繰返し除去が **第1正規形**。",
              "hint": "1 マス 1 値。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "部分関数従属を取るのはどの段？",
              "choices": ["→第1", "→第2", "→第3", "→第4"],
              "answer": 1, "explain": "1NF→**2NF** で部分従属を除去。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "繰返し → **1NF**\n部分従属 → **2NF**\n推移従属 → **3NF**" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**正規化** … 重複を減らす分割",
              "**1→2→3** … 段階を踏む",
              "目的は **冗長性の排除**"
            ] }
          ]
        }
      ]
    },
