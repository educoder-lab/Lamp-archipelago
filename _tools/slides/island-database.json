          "blocks": [
            { "t": "check", "q": "表からデータを取る SQL は？",
              "choices": ["INSERT", "UPDATE", "SELECT", "DELETE"],
              "answer": 2, "explain": "取得は **SELECT**。",
              "hint": "取り出す文。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
