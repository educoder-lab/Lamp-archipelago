                                                  "blocks":  [

                                                             ]
                                              },
                                              {
                                                  "emoji":  "🏪",
                                                  "title":  "まず、たとえ話から",
                                                  "blocks":  [
                                                                 {
                                                                     "t":  "analogy",
                                                                     "icon":  "🏪",
                                                                     "real":  "お店は商品だけでなく、\n**対応・修理・約束**も大事。",
                                                                     "tech":  "IT でも、サービスを安定して\n届ける管理があります。"
                                                                 }
                                                             ]
                                              },
                                              {
                                                  "emoji":  "📘",
                                                  "title":  "ITIL とは？",
                                                  "blocks":  [
                                                                 {
