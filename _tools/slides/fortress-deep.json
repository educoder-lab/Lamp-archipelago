            { "t": "compare",
              "left": { "icon": "🔧", "title": "機能", "items": ["できること"] },
              "right": { "icon": "🛡️", "title": "非機能", "items": ["速さ・安全など"] },
              "vs": "VS" }
          ]
        },
        {
          "emoji": "🔢", "title": "数字が出たら？",
          "blocks": [
            { "t": "callout", "kind": "memo",
              "text": "人数・時間・件数は、\n==非機能要件==のサインが多い。" }
          ]
        },
        {
          "emoji": "🧱", "title": "構成図で見るもの",
          "blocks": [
            { "t": "flow", "steps": [
              { "icon": "🌐", "label": "外" },
              { "icon": "🧱", "label": "FW", "sub": "関所" },
              { "icon": "🖥️", "label": "サーバ" }
            ], "caption": "装置の役割と並び順" }
          ]
        },
        {
          "emoji": "🧱", "title": "FW の役割",
          "blocks": [
            { "t": "big", "text": "**FW** = 通信の関所",
              "sub": "通す／止める（パケットフィルタ）" }
          ]
        },
        {
          "emoji": "🗃️", "title": "表の見方",
          "blocks": [
            { "t": "flow", "steps": [
              { "label": "列名" },
              { "label": "主キー", "sub": "行を特定" },
              { "label": "他の表とのつながり" }
            ] }
          ]
        },
        {
          "emoji": "🚧", "title": "条件の言葉に線を",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "「のみ」「以内」「ただし」に\n==線を引く==。取りこぼし防止。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認",
          "blocks": [
            { "t": "check", "q": "「同時に 500 人使える」は？",
              "choices": ["機能要件", "非機能要件", "予算だけ", "要件ではない"],
              "answer": 1,
              "explain": "「何ができるか」ではなく**質・条件**なので非機能要件。",
              "hint": "数字が出てきたら？" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**機能** … できること",
              "**非機能** … 質・条件",
              "**条件の言葉**を取りこぼさない"
            ] }
          ]
        }
      ]
    },
