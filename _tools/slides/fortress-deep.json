{
  "domain": "fortress-deep",
  "lessons": {
    "110": {
      "slides": [
        {
          "layout": "title", "emoji": "📖", "title": "長文読解の技法",
          "subtitle": "午後は「読む順番」で変わる。",
          "blocks": []
        },
        {
          "emoji": "✈️", "title": "たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "✈️",
              "real": "旅行の相談。\nまず**状況**、次に**質問**、最後に**候補**。",
              "tech": "午後も同じ。\n==問題文 → 設問 → 選択肢==" }
          ]
        },
        {
          "emoji": "📄", "title": "午後の形は 3 つ",
          "blocks": [
            { "t": "flow", "steps": [
              { "icon": "📄", "label": "問題文", "sub": "状況" },
              { "icon": "❓", "label": "設問", "sub": "聞くこと" },
              { "icon": "🔘", "label": "選択肢", "sub": "答えの候補" }
            ] }
          ]
        },
        {
          "emoji": "🛒", "title": "設問を先に読む",
          "blocks": [
            { "t": "analogy", "icon": "🛒",
              "real": "買い物リストを持って店へ。\n必要な棚だけ見られる。",
              "tech": "**設問**がリスト。\n本文は目的をもって読む。" }
          ]
        },
        {
          "emoji": "📍", "title": "下線部参照とは",
          "blocks": [
            { "t": "big", "text": "**下線部参照** = 場所を探す",
              "sub": "設問の「下線①」→ 本文の同じ番号" }
          ]
        },
        {
          "emoji": "👀", "title": "前後の文も読む",
          "blocks": [
            { "t": "flow", "steps": [
              { "label": "下線の場所", "sub": "番号で探す" },
              { "label": "前後の文", "sub": "理由・条件" }
            ], "caption": "一文だけでは足りないことが多い" }
          ]
        },
        {
          "emoji": "⚠️", "title": "下線だけで決めない",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "「ただし」「そのため」は\n==前後==に書いてあることが多い。" }
          ]
        },
        {
          "emoji": "✂️", "title": "消去法とは",
          "blocks": [
            { "t": "analogy", "icon": "🪣",
              "real": "ざるで小石を落とす。\n残ったものが本物。",
              "tech": "**消去法** =\n明らかに誤りの選択肢を先に外す。" }
          ]
        },
        {
          "emoji": "✍️", "title": "消すときは理由を書く",
          "blocks": [
            { "t": "callout", "kind": "tip",
              "text": "×のそばに一言。\n「本文にない」「設問と違う」など。" }
          ]
        },
        {
          "emoji": "📊", "title": "図表のコツ",
          "blocks": [
            { "t": "big", "text": "図表は ==必要な行だけ==",
              "sub": "設問が指す行・列を見る" }
          ]
        },
        {
          "emoji": "✅", "title": "確認",
          "blocks": [
            { "t": "check", "q": "午後で最初にやることは？",
              "choices": ["選択肢を全部読む", "設問を先に読む", "計算から始める", "暗記する"],
              "answer": 1,
              "explain": "**設問**を先に見て、目的をもって本文を読む。",
              "hint": "買い物リストのたとえ。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**設問**を先に読む",
              "**下線**は前後も見る",
              "**消去法**は理由つき"
            ] }
          ]
        }
      ]
    },
    "111": {
