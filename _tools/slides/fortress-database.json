              "right": {
                "icon": "🚫",
                "title": "排他",
                "items": ["読も書も不可"]
              },
              "vs": "VS"
            }
          ]
        },
        {
          "emoji": "2️⃣",
          "title": "2 相ロック",
          "blocks": [
            {
              "t": "flow",
              "steps": [
                { "label": "取得フェーズ", "sub": "鍵をもらう" },
                { "label": "解放フェーズ", "sub": "鍵を返す" }
              ],
              "caption": "もらう期間と返す期間を分ける"
            }
          ]
        },
        {
          "emoji": "🛡️",
          "title": "2 相の利点",
          "blocks": [
            {
              "t": "big",
              "text": "利点は ==直列可能性== の保証",
              "sub": "デッドロック防止が主目的ではない"
            }
          ]
        },
        {
          "emoji": "🎫",
          "title": "楽観的ロック",
          "blocks": [
            {
              "t": "analogy",
              "icon": "🎫",
              "real": "整理券の番号が変わっていたら、\n書き込みをやめる。",
              "tech": "**楽観的ロック**は、更新時に競合を検出。\nよく **バージョン番号** を使う。"
            }
          ]
        },
        {
          "emoji": "🔢",
          "title": "バージョン番号",
          "blocks": [
            {
              "t": "example",
              "label": "具体例",
              "title": "版番号がずれたら",
              "before": "読んだとき 版=**3**",
              "after": "書くとき 版=**4** → やり直し",
              "why": "競合を ==検出== して再実行。"
            }
          ]
        },
        {
          "emoji": "⚠️",
          "title": "よくある誤解",
          "blocks": [
            {
              "t": "callout",
              "kind": "warn",
              "text": "排他中は「読める」ではない。\n==読めない・書けない==。"
            }
          ]
        },
        {
          "emoji": "📝",
          "title": "試験の型",
          "blocks": [
            {
              "t": "callout",
              "kind": "exam",
              "text": "鍵の種類（排他/共有）と、\n方式（2相/楽観）を分けて読む。"
            }
          ]
        },
        {
          "emoji": "✅",
          "title": "確認①",
          "blocks": [
            {
              "t": "check",
              "q": "排他ロック中、他は？",
              "choices": ["読だけ可", "書だけ可", "読も書も不可", "両方可"],
              "answer": 2,
              "explain": "排他は ==読も書もできない==。",
              "hint": "トイレの鍵。"
            }
          ]
        },
        {
          "emoji": "✅",
          "title": "確認②",
          "blocks": [
            {
              "t": "check",
              "q": "楽観的ロックの検出によく使うのは？",
              "choices": ["セマフォ", "バージョン番号", "ロック表だけ", "暗号鍵"],
              "answer": 1,
              "explain": "よく **バージョン番号** で検出。",
              "hint": "整理券の番号。"
            }
          ]
        },
        {
          "emoji": "🏁",
          "title": "まとめ",
          "blocks": [
            {
              "t": "bullets",
              "items": [
                "排他 … 他は触れない",
                "2 相 … **直列可能性**",
                "楽観 … **版番号**で検出"
              ]
            }
          ]
        }
      ]
    },
