            }
          ]
        },
        {
          "emoji": "🚫",
          "title": "排他ロック",
          "blocks": [
            {
              "t": "anim",
              "caption": "▶ トイレの鍵のたとえ",
              "frames": [
                { "visual": "🔒 鍵を取得", "text": "A が排他ロック" },
                { "visual": "B は待ち", "text": "読みも書きも不可" },
                { "visual": "A が解放", "text": "次の人が入れる" }
              ]
            }
          ]
        },
        {
          "emoji": "👀",
          "title": "共有ロック",
          "blocks": [
            {
              "t": "compare",
