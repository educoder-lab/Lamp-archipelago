    "98": {
      "slides": [
        {
          "layout": "title",
          "emoji": "🗺️",
          "title": "午後 E-R 図の読解",
          "subtitle": "箱と線の図から、\n「何対何」を読み取る。",
          "blocks": []
        },
        {
          "emoji": "👪",
          "title": "たとえ話",
          "blocks": [
            {
              "t": "analogy",
              "icon": "👪",
              "real": "家族関係図。\n誰と誰が、何人つながるか。",
              "tech": "**E-R 図**は、データの箱と\nつながり（関連）の地図。"
            }
          ]
        },
        {
          "emoji": "📦",
          "title": "エンティティは箱",
          "blocks": [
            {
              "t": "big",
              "text": "**エンティティ** = ものの箱",
              "sub": "社員・部署・注文 など"
            }
          ]
        },
        {
          "emoji": "💎",
          "title": "菱形は関連",
          "blocks": [
            {
              "t": "flow",
              "steps": [
                { "label": "箱", "sub": "エンティティ" },
                { "label": "菱形", "sub": "**関連**" },
                { "label": "箱", "sub": "エンティティ" }
              ],
              "caption": "菱形 = リレーションシップ"
            }
          ]
        },
        {
          "emoji": "🔢",
          "title": "多重度（何対何）",
          "blocks": [
            {
              "t": "table",
              "head": ["記号", "意味"],
              "rows": [
                ["1:1", "1 対 1"],
                ["1:N", "1 対 多"],
                ["M:N", "多 対 多"]
              ],
              "caption": "線のそばの数字を読む"
            }
          ]
        },
        {
          "emoji": "👥",
          "title": "M:N の例",
          "blocks": [
            {
              "t": "table",
              "head": ["社員", "部署"],
              "rows": [["太郎", "営業"], ["太郎", "企画"], ["花子", "営業"]],
              "caption": "1 人が複数・1 部署に複数 → ==M:N=="
            }
          ]
        },
        {
          "emoji": "🌉",
          "title": "連関エンティティ",
          "blocks": [
            {
              "t": "big",
              "text": "M:N をほどく中間の箱",
              "sub": "名前は **連関エンティティ**"
            }
          ]
        },
        {
          "emoji": "🔧",
          "title": "ほどき方",
          "blocks": [
            {
              "t": "flow",
              "steps": [
                { "label": "社員", "sub": "M" },
                { "label": "所属", "sub": "中間" },
                { "label": "部署", "sub": "N" }
              ],
              "caption": "中間を挟んで 1:N に分ける"
            }
          ]
        },
        {
          "emoji": "🧾",
          "title": "属性の導出",
          "blocks": [
            {
              "t": "callout",
              "kind": "tip",
              "text": "図とテーブル定義を照合し、\n必要な ==列== を決める。"
            }
          ]
        },
        {
          "emoji": "📝",
          "title": "試験の型",
          "blocks": [
            {
              "t": "callout",
              "kind": "exam",
              "text": "「1 人が複数？」「1 側はどれ？」を\n先に印する。"
            }
          ]
        },
        {
          "emoji": "✅",
          "title": "確認①",
          "blocks": [
            {
              "t": "check",
              "q": "M:N をほどく中間の箱は？",
              "choices": ["弱エンティティ", "連関エンティティ", "派生だけ", "主キー"],
              "answer": 1,
              "explain": "中間は **連関エンティティ**。",
              "hint": "橋渡しの箱。"
            }
          ]
        },
        {
          "emoji": "✅",
          "title": "確認②",
          "blocks": [
            {
              "t": "check",
              "q": "E-R 図の菱形は？",
              "choices": ["エンティティ", "属性", "関連", "主キー"],
              "answer": 2,
              "explain": "菱形は ==関連==。",
              "hint": "箱と箱をつなぐ印。"
            }
          ]
        },
        {
          "emoji": "🏁",
          "title": "まとめ",
          "blocks": [
            {
              "t": "bullets",
              "items": [
                "箱 … エンティティ / 菱形 … **関連**",
                "**M:N** は中間でほどく",
                "多重度を先に読む"
              ]
            }
          ]
        }
      ]
    },
    "99": {
      "slides": [
        {
          "layout": "title",
          "emoji": "🧾",
          "title": "午後 SQL 問題演習",
          "subtitle": "相関副問合せ・EXISTS・CASE を、\n短く使い分ける。",
          "blocks": []
        },
        {
          "emoji": "📬",
          "title": "たとえ話",
          "blocks": [
            {
              "t": "analogy",
              "icon": "📬",
              "real": "外側の名簿を見ながら、\n内側でもう一度調べる。",
              "tech": "**相関副問合せ**は、外側の行の値を\n内側が ==参照== する。"
            }
          ]
        },
        {
          "emoji": "🔗",
          "title": "相関の特徴",
          "blocks": [
            {
              "t": "anim",
              "caption": "▶ 行ごとに内側が動く",
              "frames": [
                { "visual": "外側 1 行目", "text": "cat=A を内側へ" },
                { "visual": "内側 … A の平均", "text": "その平均と比較" },
                { "visual": "外側 2 行目", "text": "また ==別の cat==" }
              ]
            }
          ]
        },
        {
          "emoji": "💻",
          "title": "相関の結果イメージ",
          "blocks": [
            {
              "t": "table",
              "head": ["商品", "価格", "判定"],
              "rows": [["Aさ", "120", "平均超"], ["Aみ", "80", "平均以下"]],
              "caption": "同じカテゴリ内で平均と比べる"
            }
          ]
        },
        {
          "emoji": "✅",
          "title": "EXISTS とは",
          "blocks": [
            {
              "t": "example",
              "label": "具体例",
              "title": "注文がある顧客だけ",
              "before": "注文 0 件",
              "after": "==FALSE==（選ばれない）",
              "why": "内側に **1 行でも** あれば TRUE。"
            }
          ]
        },
        {
          "emoji": "💻",
          "title": "EXISTS の前後",
          "blocks": [
            {
              "t": "table",
              "head": ["顧客", "注文", "残る？"],
              "rows": [["C001", "あり", "○"], ["C002", "なし", "×"]],
              "caption": "EXISTS … 注文が **ある** 行だけ"
            }
          ]
        },
        {
          "emoji": "🔀",
          "title": "CASE 式",
          "blocks": [
            {
              "t": "analogy",
              "icon": "🔀",
              "real": "条件でシールの色を変える。",
              "tech": "**CASE** は条件で値を切り替える式。"
            }
          ]
        },
        {
          "emoji": "💻",
          "title": "CASE の前後",
          "blocks": [
            {
              "t": "example",
              "label": "具体例",
              "title": "点 ≥ 80 なら A",
              "before": "点: 75, 85, 92",
              "after": "評価: B, A, A",
              "why": "どれにも当たらない行は ==ELSE==。"
            }
          ]
        },
        {
          "emoji": "⚠️",
          "title": "ELSE を忘れない",
          "blocks": [
            {
              "t": "callout",
              "kind": "warn",
              "text": "どれにも当たらない時の値は\n==ELSE== で書く（DEFAULT ではない）。"
            }
          ]
        },
        {
          "emoji": "📝",
          "title": "試験の型",
          "blocks": [
            {
              "t": "callout",
              "kind": "exam",
              "text": "外側の別名を、内側が\n使っているかを先に見る。"
            }
          ]
        },
        {
          "emoji": "✅",
          "title": "確認①",
          "blocks": [
            {
              "t": "check",
              "q": "相関副問合せの特徴は？",
              "choices": ["外側と無関係", "外側の値を参照", "必ず1行", "集約禁止"],
              "answer": 1,
              "explain": "外側の値を ==参照== するのが相関。",
              "hint": "内側が外側を見る。"
            }
          ]
        },
        {
          "emoji": "✅",
          "title": "確認②",
          "blocks": [
            {
              "t": "check",
              "q": "CASE のデフォルトは？",
              "choices": ["DEFAULT", "OTHERWISE", "ELSE", "THEN"],
              "answer": 2,
              "explain": "デフォルトは **ELSE**。",
              "hint": "WHEN のあと。"
            }
          ]
        },
        {
          "emoji": "🏁",
          "title": "まとめ",
          "blocks": [
            {
              "t": "bullets",
              "items": [
                "相関 … 外側を参照",
                "**EXISTS** … あるか真偽",
                "**CASE … ELSE**"
              ]
            }
          ]
        }
      ]
    },
    "100": {
      "slides": [
        {
          "layout": "title",
          "emoji": "🔒",
          "title": "ロックと同時実行制御",
          "subtitle": "同時に触るときの「鍵」と、\n衝突の防ぎ方。",
