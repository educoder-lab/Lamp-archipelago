              "vs": "VS" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "層は ==下から数える==。\n物理が **第 1 層**。" }
          ]
        },
