        {
          "emoji": "2️⃣", "title": "第 2 層・データリンク層",
          "blocks": [
            { "t": "big", "text": "**データリンク層** = 同じネット内", "sub": "==MAC アドレス== で隣へ渡す" }
          ]
        },
        {
          "emoji": "3️⃣", "title": "第 3 層・ネットワーク層",
          "blocks": [
            { "t": "big", "text": "**ネットワーク層** = 別ネットへ", "sub": "==IP アドレス== で道順を決める" }
          ]
        },
        {
          "emoji": "4️⃣", "title": "第 4 層・トランスポート層",
          "blocks": [
            { "t": "big", "text": "**トランスポート層** = 端末どうし", "sub": "==TCP / UDP== とポート番号" }
          ]
        },
        {
          "emoji": "5️⃣", "title": "上の 3 層（5〜7）",
          "blocks": [
            { "t": "layers", "top": "利用者に近い", "bottom": "少し下",
              "items": [
                { "icon": "7️⃣", "label": "アプリ層", "sub": "HTTP・SMTP など" },
                { "icon": "6️⃣", "label": "プレゼン層", "sub": "文字コード・暗号化" },
                { "icon": "5️⃣", "label": "セッション層", "sub": "会話の開始〜終了" }
              ] }
          ]
        },
        {
          "emoji": "🏷️", "title": "MAC と IP のちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🪪", "title": "MAC", "items": ["第 2 層", "機器の番号"] },
