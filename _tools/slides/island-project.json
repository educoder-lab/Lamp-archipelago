  "domain": "island-project",
  "lessons": {
    "80": {
      "slides": [
        {
          "layout": "title", "emoji": "📋", "title": "プロジェクト管理の基礎",
          "subtitle": "期限と目標がある「一回限り」の仕事の\n進め方を学ぼう。",
          "blocks": []
        },
        {
          "emoji": "🎯", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🎉",
              "real": "文化祭の準備。「10 月 25 日の開会まで」という期限と\n「展示を完成させる」という目標が決まっている。",
              "tech": "**プロジェクト** = 期限と目標が定まった ==一回限り== の活動。" }
          ]
        },
        {
          "emoji": "🔍", "title": "プロジェクトの 3 つの特徴",
          "blocks": [
            { "t": "cards", "items": [
              { "icon": "⏰", "title": "期限あり", "text": "終わりが決まっている" },
              { "icon": "🎯", "title": "目標あり", "text": "達成するゴールが明確" },
              { "icon": "1️⃣", "title": "一回限り", "text": "毎日の定常業務とは違う" }
            ] }
          ]
        },
        {
          "emoji": "📚", "title": "PMBOK とは？",
          "blocks": [
            { "t": "big", "text": "プロジェクト管理の **知識体系（教科書）**", "sub": "10 の知識エリア・5 つのプロセス群" }
          ]
        },
        {
          "emoji": "🌳", "title": "WBS とは？",
          "blocks": [
            { "t": "analogy", "icon": "🧩",
              "real": "文化祭の「展示準備」を「台本作り・小道具・練習」に分解する。\nさらに細かくしていく。",
              "tech": "**WBS** = 成果物を階層的に ==作業へ分解== した図。" }
          ]
        },
        {
          "emoji": "🌳", "title": "WBS のイメージ",
          "blocks": [
            { "t": "anim", "caption": "▶ を押して分解を見る",
              "frames": [
                { "visual": "📋 文化祭プロジェクト", "text": "まず大きなまとまりを置く" },
                { "visual": "🎨 展示 / 🎵 ステージ / 🍱 模擬店", "text": "エリアに分ける" },
                { "visual": "✏️ 台本 / 🖼️ 看板 / 🎭 衣装", "text": "さらに細かい作業に分解" }
              ] }
          ]
        },
        {
          "emoji": "📊", "title": "ガントチャート",
          "blocks": [
            { "t": "big", "text": "横軸が **時間** の棒グラフ", "sub": "各タスクの開始・終了が一目でわかる" }
          ]
        },
        {
          "emoji": "🏁", "title": "マイルストーン",
          "blocks": [
            { "t": "big", "text": "プロジェクトの **重要な節目**", "sub": "例: 設計完了・テスト開始・リリース日" }
          ]
        },
        {
          "emoji": "🔍", "title": "WBS とガントのちがい",
          "blocks": [
            { "t": "compare",
              "left": { "icon": "🌳", "title": "WBS", "items": ["**何を**やるかを ==分解=="] },
              "right": { "icon": "📊", "title": "ガント", "items": ["**いつ**やるかを ==時間で== 見る"] },
              "vs": "役割" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "「分解」→ WBS。\n「棒で期間」→ ガント。「節目」→ マイルストーン。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "期限と目標が決まった一回限りの活動を何と呼ぶ？",
              "choices": ["運用", "プロジェクト", "保守", "監査"],
              "answer": 1, "explain": "一回限り＝**プロジェクト**。", "hint": "終わりがある仕事。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "仕事を階層的に細かく分解した図は？",
              "choices": ["ガントチャート", "WBS", "PERT", "PMBOK"],
              "answer": 1, "explain": "**WBS** は作業分解構造。", "hint": "木のように枝分かれする。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**プロジェクト** … 期限・目標・一回限り", "**WBS** … 作業の分解", "**ガント** … 時間の棒／**マイルストーン** … 節目"] }
          ]
        }
      ]
    },
    "81": {
      "slides": [
        {
          "layout": "title", "emoji": "⏱️", "title": "スケジュールと工数",
          "subtitle": "いつ終わるか・どれくらいかかるかを\n見積もる。",
          "blocks": []
        },
        {
          "emoji": "🗺️", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🗺️",
              "real": "旅行の計画。「東京→大阪→京都」と\n「東京→名古屋→京都」ではどちらが長いか。\n長い経路が到着時間を決める。",
              "tech": "プロジェクトでも、最長の経路が ==最短工期== になる。" }
          ]
        },
        {
          "emoji": "🏹", "title": "アローダイアグラム",
          "blocks": [
            { "t": "big", "text": "作業を **矢印**で表す図", "sub": "依存関係と日数を矢印のネットワークで描く" }
          ]
        },
        {
          "emoji": "🔢", "title": "PERT ① 作業を並べる",
          "blocks": [
            { "t": "flow", "stepwise": true, "steps": [
              { "label": "作業 A（3 日）", "sub": "企画" },
              { "label": "作業 B（2 日）", "sub": "デザイン" },
              { "label": "作業 C（4 日）", "sub": "開発" },
              { "label": "完成", "sub": "ゴール" }
            ], "caption": "まず作業と前後関係を洗い出す" }
          ]
        },
        {
          "emoji": "📐", "title": "PERT ② クリティカルパス",
          "blocks": [
            { "t": "big", "text": "**クリティカルパス** = 最長経路", "sub": "ここがプロジェクトの ==最短工期== を決める" }
          ]
        },
        {
          "emoji": "🧮", "title": "クリティカルパスの例",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "2 経路を比べる",
              "rows": [
                { "label": "経路 ①", "value": "A(3日) → C(5日) = 8 日" },
                { "label": "経路 ②", "value": "A(3日) → B(2日) → D(4日) = 9 日" },
                { "label": "クリティカルパス", "value": "経路 ② ==9 日==（最長）", "hl": true }
              ],
              "why": "最長経路が工期を決める。短い経路を短縮しても工期は縮まらない。" }
          ]
        },
        {
          "emoji": "⚠️", "title": "まちがえやすい点",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "クリティカルパスは **最長**。\n「クリティカル（重要な）」は「短い」ではない。" }
          ]
        },
        {
          "emoji": "📐", "title": "FP 法",
          "blocks": [
            { "t": "big", "text": "**FP 法** = 機能の数・複雑さから工数を見積もる", "sub": "ファンクションポイント法" }
          ]
        },
        {
          "emoji": "💻", "title": "COCOMO",
          "blocks": [
            { "t": "big", "text": "**COCOMO** = ソースコード行数から工数を推定", "sub": "規模が大きいほど工数も増えるモデル" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "作業を矢印でつないで表す図は？",
              "choices": ["ガントチャート", "アローダイアグラム", "クラス図", "WBS"],
              "answer": 1, "explain": "矢印のネットワーク＝**アローダイアグラム**。", "hint": "矢印。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "クリティカルパスの説明として正しいのは？",
              "choices": ["最短の作業経路", "最長の作業経路", "並列する全経路", "コストが最も低い経路"],
              "answer": 1, "explain": "**最長経路**がクリティカルパス。工期を決める。", "hint": "長い方が工期を縛る。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["**クリティカルパス** … 最長経路＝最短工期", "**FP 法** … 機能数から見積もり", "**COCOMO** … 行数から推定"] }
          ]
        }
      ]
    },
    "82": {
      "slides": [
        {
          "layout": "title", "emoji": "⚠️", "title": "リスクと品質管理",
          "subtitle": "悪いことが起きる前に備え、\n品質を守る。",
          "blocks": []
        },
        {
          "emoji": "☔", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "☔",
              "real": "遠足の前に「雨が降ったら中止？ 室内に変える？」を考えておく。\n起きてからでは遅い。",
              "tech": "**リスク管理** = 悪いことの特定・分析・対応を計画する活動。" }
          ]
        },
        {
          "emoji": "🔢", "title": "リスク管理の流れ",
          "blocks": [
            { "t": "flow", "stepwise": true, "steps": [
              { "label": "①特定", "sub": "何が起きうるか列挙" },
              { "label": "②評価", "sub": "確率×影響を分析" },
              { "label": "③対応策", "sub": "回避・転嫁・軽減・受容" },
              { "label": "④監視", "sub": "継続してチェック" }
            ], "caption": "まず「見える化」から始める" }
          ]
        },
        {
          "emoji": "🚫", "title": "リスク回避",
          "blocks": [
            { "t": "big", "text": "原因になる活動を **やめる**", "sub": "そもそもそのリスクに近づかない" }
          ]
        },
        {
          "emoji": "🏔️", "title": "遠足での例",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "登山コースをやめる",
              "before": "山道コース（転倒リスク）",
              "after": "平原コースに変更",
              "afterLabel": "回避",
              "why": "リスクの原因になる行動そのものをやめる。" }
          ]
        },
        {
          "emoji": "🛡️", "title": "リスク転嫁",
          "blocks": [
            { "t": "analogy", "icon": "🛡️",
              "real": "旅行の延期リスクを保険に入って第三者に移す。",
              "tech": "**転嫁** = リスクを ==第三者へ移す== こと（保険・外注）。" }
          ]
        },
        {
          "emoji": "📊", "title": "EVM とは？",
          "blocks": [
            { "t": "p", "text": "**EVM** = 出来高でコストと\nスケジュールの進捗を ==数字で管理== する手法。" }
          ]
        },
        {
          "emoji": "🏷️", "title": "EVM の 3 指標",
          "blocks": [
            { "t": "cards", "items": [
              { "icon": "📅", "title": "PV", "text": "計画作業量の予算額" },
              { "icon": "✅", "title": "EV", "text": "完了した作業の予算額" },
              { "icon": "💸", "title": "AC", "text": "実際にかかった費用" }
            ] }
          ]
        },
        {
          "emoji": "🧮", "title": "EVM で読み解く",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "今の状態は？",
              "rows": [
                { "label": "PV（計画）", "value": "100 万円分の作業を終える予定" },
                { "label": "EV（実績）", "value": "80 万円分しか終わっていない" },
                { "label": "状態", "value": "==20% 遅延== している", "hl": true }
              ],
              "why": "EV < PV ならスケジュール遅延。AC > EV ならコスト超過。" }
          ]
        },
        {
          "emoji": "⭐", "title": "品質管理",
          "blocks": [
            { "t": "big", "text": "求められた品質を **満たす仕組み**", "sub": "基準を決めて確認・改善する" }
          ]
        },
        {
          "emoji": "📝", "title": "試験ではここ",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "「保険・外注」→ 転嫁。\n「計画の予算額」→ PV。最初の一歩は特定。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "リスクの原因となる活動そのものをやめる対策は？",
              "choices": ["転嫁", "回避", "受容", "EVM"],
              "answer": 1, "explain": "やめる＝**回避**。", "hint": "近づかない。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "EVM で、計画した作業量の予算額を表すのは？",
              "choices": ["AC", "EV", "PV", "BCP"],
              "answer": 2, "explain": "**PV**（Planned Value）が計画作業量の予算額。", "hint": "P = Planned。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": ["リスク管理はまず **特定**", "**転嫁** … 第三者へ移す", "**PV/EV/AC** … EVM の 3 指標"] }
          ]
        }
      ]
    }
  }
}
