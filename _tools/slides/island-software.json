    "34": {
      "slides": [
        {
          "layout": "title", "emoji": "🖥️", "title": "OS とプロセス",
          "subtitle": "パソコンの「管理人」が\n何をしているかを知る。",
          "blocks": []
        },
        {
          "emoji": "🏨", "title": "まず、たとえ話から",
          "blocks": [
            { "t": "analogy", "icon": "🏨",
              "real": "ホテルの**支配人**。\n部屋・鍵・掃除を一手に引き受ける。",
              "tech": "**OS** も同じ。\nハードを管理し、アプリを助ける。" }
          ]
        },
        {
          "emoji": "🧱", "title": "三層で見る",
          "blocks": [
            { "t": "layers", "top": "上", "bottom": "下",
              "items": [
                { "icon": "📱", "label": "アプリ" },
                { "icon": "🏨", "label": "OS" },
                { "icon": "🔩", "label": "ハードウェア" }
              ] }
          ]
        },
        {
          "emoji": "🧰", "title": "OS の仕事",
          "blocks": [
            { "t": "cards", "items": [
              { "icon": "⚙️", "title": "プロセス", "text": "誰に CPU を渡すか" },
              { "icon": "🧠", "title": "メモリ", "text": "記憶領域の割り当て" },
              { "icon": "🗂️", "title": "ファイル", "text": "保存と読み出し" }
            ] }
          ]
        },
        {
          "emoji": "❤️", "title": "カーネルとは？",
          "blocks": [
            { "t": "big", "text": "**カーネル** = OS の中核", "sub": "資源管理と割込み処理を担う" }
          ]
        },
        {
          "emoji": "🍳", "title": "プロセスとは？",
          "blocks": [
            { "t": "analogy", "icon": "📖",
              "real": "**レシピ**は棚にある本。\n**料理中**が、いま動いている状態。",
              "tech": "**プロセス** = 実行中のプログラムの単位" }
          ]
        },
        {
          "emoji": "🧵", "title": "スレッドとは？",
          "blocks": [
            { "t": "analogy", "icon": "👩‍🍳",
              "real": "1 つのキッチンで\n**複数の料理人**が分担する。",
              "tech": "**スレッド** = プロセス内の実行単位\n（軽量プロセスとも）" }
          ]
        },
        {
          "emoji": "🔀", "title": "マルチタスク",
          "blocks": [
            { "t": "big", "text": "==切り替えて並行実行==", "sub": "短い時間で次々交代する仕組み" }
          ]
        },
        {
          "emoji": "🎬", "title": "切り替えのイメージ",
          "blocks": [
            { "t": "anim", "caption": "▶ 2 つの仕事",
              "frames": [
                { "visual": "A を少し", "text": "プロセス A に CPU" },
                { "visual": "B を少し", "text": "すぐ **切り替え** → B" },
                { "visual": "A に戻る", "text": "速いので ==同時== に見える" }
              ] }
          ]
        },
        {
          "emoji": "📊", "title": "起動の数",
          "blocks": [
            { "t": "example", "label": "具体例",
              "rows": [
                { "label": "メモ帳を 2 回起動", "value": "プロセス ==2 個==" },
                { "label": "1 つ終了", "value": "1 個に減る", "hl": true }
              ],
              "why": "起動のたびに実行中の単位が増える。" }
          ]
        },
        {
          "emoji": "⚠️", "title": "まちがえやすい点",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "OS は**資源の管理人**。\n経営戦略などの仕事ではない。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認",
          "blocks": [
            { "t": "check", "q": "同じアプリを 2 回起動した。プロセスは？",
              "choices": ["1 つ", "2 つ", "0 個", "アプリ数と同じで不定"],
              "answer": 1, "explain": "起動のたびに **プロセス** が増える。",
              "hint": "実行中の単位を数える。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "「OS の役割でないもの」\n→ **アプリや経営の仕事**を探す。" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**OS** … ハードを管理する基盤",
              "**プロセス / スレッド** … 実行の単位",
              "**マルチタスク** … 切り替えて並行"
            ] }
          ]
        }
      ]
    },
