          ]
        },
        {
          "emoji": "🔢", "title": "セマフォ",
          "blocks": [
            { "t": "big", "text": "**セマフォ** = 利用可能数のカウンタ", "sub": "排他制御を実現する仕組み" }
          ]
        },
        {
          "emoji": "☠️", "title": "デッドロック",
          "blocks": [
            { "t": "analogy", "icon": "🤝",
              "real": "A は B の鍵待ち、\nB は A の鍵待ち。**動けない**。",
              "tech": "**デッドロック** =\n互いに解放を待ち合って停止" }
          ]
        },
        {
          "emoji": "🎬", "title": "ラウンドロビン",
          "blocks": [
            { "t": "anim", "caption": "▶ 3 人が 1 つずつ",
              "frames": [
                { "visual": "A: 100ms", "text": "一定時間だけ CPU" },
                { "visual": "B: 100ms", "text": "次の人へ **交代**" },
                { "visual": "C: 100ms", "text": "また A へ … 公平に回る" }
              ] }
          ]
        },
        {
          "emoji": "📊", "title": "セマフォの例",
          "blocks": [
            { "t": "example", "label": "具体例", "title": "プリンタ 1 台",
              "before": "カウンタ = 1",
              "after": "0 まで使うと待ち",
              "afterLabel": "利用可能数",
              "why": "==同時に 1 人だけ== が使えるイメージ。" }
          ]
        },
        {
          "emoji": "⚠️", "title": "注意",
          "blocks": [
            { "t": "callout", "kind": "warn",
              "text": "排他を強くしすぎると\n==デッドロック== になりやすい。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認①",
          "blocks": [
            { "t": "check", "q": "「みんな同じ長さの時間」で交代する方式は？",
              "choices": ["優先度方式", "ラウンドロビン", "バッチ", "分散"],
              "answer": 1, "explain": "**ラウンドロビン**は均等なタイムスライス。",
              "hint": "公平に交代。" }
          ]
        },
        {
          "emoji": "✅", "title": "確認②",
          "blocks": [
            { "t": "check", "q": "共有プリンタを同時に使わせない考え方は？",
              "choices": ["マルチタスク", "排他制御", "ページング", "仮想化"],
              "answer": 1, "explain": "**排他制御**で同時アクセスを防ぐ。" }
          ]
        },
        {
          "emoji": "📝", "title": "試験の型",
          "blocks": [
            { "t": "callout", "kind": "exam",
              "text": "「待ち合いで止まる」→ **デッドロック**\n「カウンタで人数制限」→ **セマフォ**" }
          ]
        },
        {
          "emoji": "🏁", "title": "まとめ",
          "blocks": [
            { "t": "bullets", "items": [
              "**ラウンドロビン** … 均等時間",
              "**排他 / セマフォ** … 同時利用を防ぐ",
              "**デッドロック** … 待ち合い停止"
            ] }
          ]
        }
      ]
    },
